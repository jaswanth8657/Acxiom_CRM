@{
    ViewData["Title"] = "Access Denied";
}

<div class="row justify-content-center py-5">
    <div class="col-12 col-md-6 text-center">
        <div class="card shadow border-0 p-4">
            <div class="card-body">
                <div class="text-warning mb-3">
                    <i class="bi bi-slash-circle" style="font-size: 3.5rem;"></i>
                </div>
                <h2 class="h3 fw-bold text-dark mb-2">Access Denied (403)</h2>
                <p class="text-muted">
                    You do not have the required role or authorization permissions to access this CRM resource.
                    Role-based access is strictly enforced server-side.
                </p>
                <div class="mt-4">
                    <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary me-2">
                        <i class="bi bi-speedometer2 me-1"></i> Go to Dashboard
                    </a>
                    <a asp-action="Login" class="btn btn-outline-secondary">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Switch Account
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
