@{
    ViewData["Title"] = "Account Locked Out";
}

<div class="row justify-content-center py-5">
    <div class="col-12 col-md-6 text-center">
        <div class="card shadow border-0 p-4">
            <div class="card-body">
                <div class="text-danger mb-3">
                    <i class="bi bi-shield-exclamation" style="font-size: 3.5rem;"></i>
                </div>
                <h2 class="h3 fw-bold text-danger mb-2">Account Temporarily Locked</h2>
                <p class="text-muted">
                    This account has been temporarily locked out due to multiple failed login attempts.
                    Please wait a few minutes before trying again or contact your CRM system administrator.
                </p>
                <a asp-action="Login" class="btn btn-outline-secondary mt-3">
                    <i class="bi bi-arrow-left me-1"></i> Back to Sign In
                </a>
            </div>
        </div>
    </div>
</div>
