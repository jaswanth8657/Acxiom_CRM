@model AcxiomCRM.ViewModels.Account.LoginViewModel
@{
    ViewData["Title"] = "Sign In";
}

<div class="row justify-content-center py-5">
    <div class="col-12 col-md-8 col-lg-5">
        <div class="card shadow border-0 rounded-3">
            <div class="card-header bg-primary text-white text-center py-4 rounded-top-3">
                <h3 class="fw-bold mb-1"><i class="bi bi-shield-lock me-2"></i>AcxiomCRM</h3>
                <p class="mb-0 small text-white-50">Enterprise Customer Relationship Management</p>
            </div>
            <div class="card-body p-4 p-md-5">
                <div class="text-center mb-4">
                    <h4 class="fw-semibold text-dark">Welcome Back</h4>
                    <p class="text-muted small">Please sign in to access your sales workspace</p>
                </div>

                <form asp-controller="Account" asp-action="Login" asp-route-returnurl="@ViewData["ReturnUrl"]" method="post" novalidate>
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold small text-secondary"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted"><i class="bi bi-envelope"></i></span>
                            <input asp-for="Email" class="form-control" placeholder="name@company.com" autocomplete="username" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-semibold small text-secondary"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted"><i class="bi bi-key"></i></span>
                            <input asp-for="Password" class="form-control" placeholder="••••••••" autocomplete="current-password" />
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div class="form-check">
                            <input asp-for="RememberMe" class="form-check-input" />
                            <label asp-for="RememberMe" class="form-check-label small text-muted"></label>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold shadow-sm">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
                    </button>
                </form>

                <div class="mt-4 pt-3 border-top text-center">
                    <p class="text-muted small mb-0">
                        Don't have an account?
                        <a asp-action="Register" class="text-primary fw-semibold text-decoration-none">Register here</a>
                    </p>
                </div>
            </div>
            <div class="card-footer bg-light text-center py-3 text-muted small rounded-bottom-3">
                <i class="bi bi-lock me-1"></i> Role-Based Access Control • ASP.NET Core Identity
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
