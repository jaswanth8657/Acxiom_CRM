@model AcxiomCRM.ViewModels.Account.RegisterViewModel
@{
    ViewData["Title"] = "Create Account";
}

<div class="row justify-content-center py-5">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="card shadow border-0 rounded-3">
            <div class="card-header bg-primary text-white text-center py-4 rounded-top-3">
                <h3 class="fw-bold mb-1"><i class="bi bi-person-plus me-2"></i>AcxiomCRM</h3>
                <p class="mb-0 small text-white-50">Sales Force & Relationship Management</p>
            </div>
            <div class="card-body p-4 p-md-5">
                <div class="text-center mb-4">
                    <h4 class="fw-semibold text-dark">Register New User</h4>
                    <p class="text-muted small">Create your account to start managing leads and pipeline</p>
                </div>

                <form asp-controller="Account" asp-action="Register" method="post" novalidate>
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label fw-semibold small text-secondary"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted"><i class="bi bi-person"></i></span>
                            <input asp-for="FullName" class="form-control" placeholder="John Doe" autocomplete="name" />
                        </div>
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold small text-secondary"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted"><i class="bi bi-envelope"></i></span>
                            <input asp-for="Email" class="form-control" placeholder="john.doe@company.com" autocomplete="username" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="SelectedRole" class="form-label fw-semibold small text-secondary"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted"><i class="bi bi-shield-check"></i></span>
                            <select asp-for="SelectedRole" class="form-select">
                                <option value="SalesExecutive">SalesExecutive (Default)</option>
                                <option value="Manager">Manager</option>
                                <option value="Admin">Admin</option>
                            </select>
                        </div>
                        <span asp-validation-for="SelectedRole" class="text-danger small"></span>
                        <div class="form-text small text-muted">Role permissions will be enforced automatically server-side.</div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Password" class="form-label fw-semibold small text-secondary"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted"><i class="bi bi-key"></i></span>
                                <input asp-for="Password" class="form-control" placeholder="••••••••" autocomplete="new-password" />
                            </div>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="ConfirmPassword" class="form-label fw-semibold small text-secondary"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted"><i class="bi bi-check2-circle"></i></span>
                                <input asp-for="ConfirmPassword" class="form-control" placeholder="••••••••" autocomplete="new-password" />
                            </div>
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold shadow-sm mt-2">
                        <i class="bi bi-person-check me-1"></i> Register Account
                    </button>
                </form>

                <div class="mt-4 pt-3 border-top text-center">
                    <p class="text-muted small mb-0">
                        Already have an account?
                        <a asp-action="Login" class="text-primary fw-semibold text-decoration-none">Sign in here</a>
                    </p>
                </div>
            </div>
            <div class="card-footer bg-light text-center py-3 text-muted small rounded-bottom-3">
                <i class="bi bi-shield-lock me-1"></i> Passwords secured via PBKDF2 hashing • Identity Core
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
