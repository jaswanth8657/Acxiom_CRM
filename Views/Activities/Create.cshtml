@model AcxiomCRM.ViewModels.Activities.ActivityCreateViewModel
@{
    ViewData["Title"] = "Log Activity";
}

<div class="container-fluid py-3">
    <!-- Breadcrumb & Header -->
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-2 small">
            <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Activities</a></li>
            <li class="breadcrumb-item active" aria-current="page">Log Activity</li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-center pb-3 mb-4 border-bottom">
        <div>
            <h1 class="h3 fw-bold text-dark mb-0">Log Activity</h1>
            <p class="text-muted mb-0 small">Record a phone call, meeting notes, email interaction, or customer task</p>
        </div>
        <div>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Back to List
            </a>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-12 col-lg-8">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-body p-4">
                    <form asp-action="Create" method="post" id="createActivityForm">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <!-- 1. Activity Information -->
                        <h5 class="fw-bold text-dark border-bottom pb-2 mb-3">
                            <i class="bi bi-clock-history text-primary me-2"></i>Activity Information
                        </h5>

                        <div class="row g-3 mb-4">
                            <div class="col-12">
                                <label asp-for="Subject" class="form-label fw-semibold text-secondary"></label>
                                <input asp-for="Subject" class="form-control" placeholder="e.g. Discussed pricing contract and onboarding dates" />
                                <span asp-validation-for="Subject" class="text-danger small"></span>
                            </div>

                            <div class="col-12 col-md-4">
                                <label asp-for="Type" class="form-label fw-semibold text-secondary"></label>
                                <select asp-for="Type" class="form-select" asp-items="Html.GetEnumSelectList<AcxiomCRM.Models.ActivityType>()"></select>
                                <span asp-validation-for="Type" class="text-danger small"></span>
                            </div>

                            <div class="col-12 col-md-4">
                                <label asp-for="Status" class="form-label fw-semibold text-secondary"></label>
                                <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<AcxiomCRM.Models.ActivityStatus>()"></select>
                                <span asp-validation-for="Status" class="text-danger small"></span>
                            </div>

                            <div class="col-12 col-md-4">
                                <label asp-for="ActivityDate" class="form-label fw-semibold text-secondary"></label>
                                <input asp-for="ActivityDate" class="form-control" type="datetime-local" value="@Model.ActivityDate.ToString("yyyy-MM-ddTHH:mm")" />
                                <span asp-validation-for="ActivityDate" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- 2. CRM Link -->
                        <h5 class="fw-bold text-dark border-bottom pb-2 mb-3">
                            <i class="bi bi-link-45deg text-primary me-2"></i>Associated CRM Entity
                        </h5>
                        <p class="text-muted small mb-3">Link this activity to a Customer, Lead, or Opportunity:</p>

                        <div class="row g-3 mb-4">
                            <div class="col-12 col-md-4">
                                <label asp-for="CustomerId" class="form-label fw-semibold text-secondary"></label>
                                <select asp-for="CustomerId" class="form-select" asp-items="Model.AvailableCustomers">
                                    <option value="">-- None / Select Customer --</option>
                                </select>
                                <span asp-validation-for="CustomerId" class="text-danger small"></span>
                            </div>

                            <div class="col-12 col-md-4">
                                <label asp-for="LeadId" class="form-label fw-semibold text-secondary"></label>
                                <select asp-for="LeadId" class="form-select" asp-items="Model.AvailableLeads">
                                    <option value="">-- None / Select Lead --</option>
                                </select>
                                <span asp-validation-for="LeadId" class="text-danger small"></span>
                            </div>

                            <div class="col-12 col-md-4">
                                <label asp-for="OpportunityId" class="form-label fw-semibold text-secondary"></label>
                                <select asp-for="OpportunityId" class="form-select" asp-items="Model.AvailableOpportunities">
                                    <option value="">-- None / Select Opportunity --</option>
                                </select>
                                <span asp-validation-for="OpportunityId" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- 3. Details & User -->
                        <h5 class="fw-bold text-dark border-bottom pb-2 mb-3">
                            <i class="bi bi-card-text text-primary me-2"></i>Outcome & Details
                        </h5>

                        <div class="row g-3 mb-4">
                            @if (Model.CanAssignAny && Model.AvailableUsers.Any())
                            {
                                <div class="col-12 col-md-6">
                                    <label asp-for="UserId" class="form-label fw-semibold text-secondary"></label>
                                    <select asp-for="UserId" class="form-select" asp-items="Model.AvailableUsers"></select>
                                    <span asp-validation-for="UserId" class="text-danger small"></span>
                                </div>
                            }

                            <div class="col-12">
                                <label asp-for="Description" class="form-label fw-semibold text-secondary"></label>
                                <textarea asp-for="Description" class="form-control" rows="4" placeholder="Detailed notes, discussion topics, agreed action items..."></textarea>
                                <span asp-validation-for="Description" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 border-top pt-3">
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                            <button type="submit" class="btn btn-primary px-4">
                                <i class="bi bi-check-lg me-1"></i> Save Activity
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
