@model AcxiomCRM.ViewModels.Activities.ActivityDetailsViewModel
@{
    ViewData["Title"] = $"Activity Details - {Model.Subject}";
}

<div class="container-fluid py-3">
    <!-- Breadcrumb & Header -->
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-2 small">
            <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Activities</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Subject</li>
        </ol>
    </nav>

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center pb-3 mb-4 border-bottom">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <h1 class="h3 fw-bold text-dark mb-0">@Model.Subject</h1>
                @switch (Model.Status)
                {
                    case AcxiomCRM.Models.ActivityStatus.Completed:
                        <span class="badge bg-success"><i class="bi bi-check2-circle me-1"></i>Completed</span>
                        break;
                    case AcxiomCRM.Models.ActivityStatus.Planned:
                        <span class="badge bg-info text-dark">Planned</span>
                        break;
                    case AcxiomCRM.Models.ActivityStatus.Cancelled:
                        <span class="badge bg-secondary">Cancelled</span>
                        break;
                }
                <span class="badge bg-light text-dark border">@Model.Type</span>
            </div>
            <p class="text-muted mb-0 small">
                Logged by: <strong>@Model.UserName</strong>
                &bull; Activity Date: <strong>@Model.ActivityDate.ToString("MMM dd, yyyy HH:mm")</strong>
                &bull; Recorded: @Model.CreatedAt.ToString("MMM dd, yyyy HH:mm")
            </p>
        </div>

        <div class="d-flex flex-wrap gap-2 mt-3 mt-md-0">
            @if (Model.CanEdit && Model.Status == AcxiomCRM.Models.ActivityStatus.Planned)
            {
                <form asp-action="Complete" asp-route-id="@Model.Id" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-check2-circle me-1"></i> Mark Completed
                    </button>
                </form>

                <form asp-action="Cancel" asp-route-id="@Model.Id" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-secondary">
                        <i class="bi bi-slash-circle me-1"></i> Cancel
                    </button>
                </form>
            }

            @if (Model.CanEdit)
            {
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">
                    <i class="bi bi-pencil me-1"></i> Edit
                </a>
            }

            @if (Model.CanDelete)
            {
                <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this activity log?');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-danger">
                        <i class="bi bi-trash me-1"></i> Delete
                    </button>
                </form>
            }

            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Back to List
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">
        <!-- Left: Summary -->
        <div class="col-12 col-lg-5 col-xl-4">
            <div class="card border-0 shadow-sm rounded-3 mb-4">
                <div class="card-header bg-white py-3 border-bottom">
                    <h5 class="card-title mb-0 fw-semibold text-dark">Activity Overview</h5>
                </div>
                <div class="card-body p-3">
                    <div class="list-group list-group-flush">
                        <div class="list-group-item px-0 py-2 d-flex justify-content-between align-items-center">
                            <span class="text-muted small">Activity Type</span>
                            <span class="fw-semibold text-dark">@Model.Type</span>
                        </div>
                        <div class="list-group-item px-0 py-2 d-flex justify-content-between align-items-center">
                            <span class="text-muted small">Status</span>
                            <span class="fw-semibold text-dark">@Model.Status</span>
                        </div>
                        <div class="list-group-item px-0 py-2 d-flex justify-content-between align-items-center">
                            <span class="text-muted small">Activity Timestamp</span>
                            <span class="fw-semibold text-dark">@Model.ActivityDate.ToString("MMM dd, yyyy HH:mm")</span>
                        </div>
                        <div class="list-group-item px-0 py-2 d-flex justify-content-between align-items-center">
                            <span class="text-muted small">Performed By</span>
                            <span class="fw-semibold text-dark">@Model.UserName</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Related Entity -->
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white py-3 border-bottom">
                    <h5 class="card-title mb-0 fw-semibold text-dark">Associated CRM Record</h5>
                </div>
                <div class="card-body p-3">
                    <div class="list-group list-group-flush">
                        @if (Model.CustomerId.HasValue)
                        {
                            <div class="list-group-item px-0 py-2 d-flex justify-content-between align-items-center">
                                <span class="text-muted small">Customer Account</span>
                                <a asp-controller="Customers" asp-action="Details" asp-route-id="@Model.CustomerId.Value" class="fw-semibold text-primary text-decoration-none small">
                                    <i class="bi bi-building me-1"></i>@Model.CustomerName
                                </a>
                            </div>
                        }

                        @if (Model.LeadId.HasValue)
                        {
                            <div class="list-group-item px-0 py-2 d-flex justify-content-between align-items-center">
                                <span class="text-muted small">Sales Lead</span>
                                <a asp-controller="Leads" asp-action="Details" asp-route-id="@Model.LeadId.Value" class="fw-semibold text-primary text-decoration-none small">
                                    <i class="bi bi-funnel me-1"></i>@Model.LeadName
                                </a>
                            </div>
                        }

                        @if (Model.OpportunityId.HasValue)
                        {
                            <div class="list-group-item px-0 py-2 d-flex justify-content-between align-items-center">
                                <span class="text-muted small">Opportunity Deal</span>
                                <a asp-controller="Opportunities" asp-action="Details" asp-route-id="@Model.OpportunityId.Value" class="fw-semibold text-primary text-decoration-none small">
                                    <i class="bi bi-currency-dollar me-1"></i>@Model.OpportunityName
                                </a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Right: Description -->
        <div class="col-12 col-lg-7 col-xl-8">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white py-3 border-bottom">
                    <h5 class="card-title mb-0 fw-semibold text-dark">
                        <i class="bi bi-card-text text-primary me-2"></i>Activity Notes & Outcome
                    </h5>
                </div>
                <div class="card-body p-4">
                    @if (!string.IsNullOrWhiteSpace(Model.Description))
                    {
                        <div class="p-3 bg-light rounded-3 text-secondary" style="white-space: pre-wrap;">@Model.Description</div>
                    }
                    else
                    {
                        <div class="text-muted small fst-italic">No additional details recorded for this activity.</div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
