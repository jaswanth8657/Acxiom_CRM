@model AcxiomCRM.ViewModels.Activities.ActivityListViewModel
@{
    ViewData["Title"] = "Activities";
}

<div class="container-fluid py-3">
    <!-- Header -->
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center pb-3 mb-3 border-bottom">
        <div>
            <h1 class="h3 fw-bold text-dark mb-1">
                <i class="bi bi-clock-history text-primary me-2"></i>Activity History & Logs
            </h1>
            <p class="text-muted mb-0 small">
                Track calls, meetings, notes, and tasks logged across customer accounts and pipeline deals
            </p>
        </div>
        <div class="mt-3 mt-sm-0">
            <a asp-action="Create" class="btn btn-primary px-3 shadow-sm">
                <i class="bi bi-plus-circle me-1"></i> Log Activity
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Search & Filter Card -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3 p-md-4">
            <form method="get" asp-action="Index" class="row g-2 align-items-end">
                <div class="col-12 col-md-3">
                    <label class="form-label small fw-semibold text-secondary">Search</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light text-muted"><i class="bi bi-search"></i></span>
                        <input type="text" name="SearchTerm" class="form-control" placeholder="Subject, description, customer..." value="@Model.Filter.SearchTerm" />
                    </div>
                </div>

                <div class="col-6 col-md-2">
                    <label class="form-label small fw-semibold text-secondary">Type</label>
                    <select name="Type" class="form-select">
                        <option value="">All Types</option>
                        @foreach (var t in Model.AvailableTypes)
                        {
                            <option value="@t.Value" selected="@(t.Selected)">@t.Text</option>
                        }
                    </select>
                </div>

                <div class="col-6 col-md-2">
                    <label class="form-label small fw-semibold text-secondary">Status</label>
                    <select name="Status" class="form-select">
                        <option value="">All Statuses</option>
                        @foreach (var s in Model.AvailableStatuses)
                        {
                            <option value="@s.Value" selected="@(s.Selected)">@s.Text</option>
                        }
                    </select>
                </div>

                @if (Model.CanManageAll && Model.AvailableUsers.Any())
                {
                    <div class="col-6 col-md-2">
                        <label class="form-label small fw-semibold text-secondary">User</label>
                        <select name="UserId" class="form-select">
                            <option value="">All Team Members</option>
                            @foreach (var u in Model.AvailableUsers)
                            {
                                <option value="@u.Value" selected="@(u.Selected)">@u.Text</option>
                            }
                        </select>
                    </div>
                }

                <div class="col-6 col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary flex-grow-1">
                        <i class="bi bi-filter me-1"></i> Filter
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Activities Table -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <h5 class="card-title mb-0 fw-semibold text-dark">
                Activity Logs (@Model.TotalItems)
            </h5>
            <span class="text-muted small">Page @Model.CurrentPage of @(Model.TotalPages == 0 ? 1 : Model.TotalPages)</span>
        </div>
        <div class="card-body p-0">
            @if (Model.Activities.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3 text-secondary small fw-semibold">Subject</th>
                                <th class="text-secondary small fw-semibold">Type</th>
                                <th class="text-secondary small fw-semibold">Status</th>
                                <th class="text-secondary small fw-semibold">Associated Record</th>
                                <th class="text-secondary small fw-semibold">Activity Date</th>
                                <th class="text-secondary small fw-semibold">Logged By</th>
                                <th class="text-end pe-3 text-secondary small fw-semibold">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var a in Model.Activities)
                            {
                                <tr>
                                    <td class="ps-3">
                                        <div class="fw-semibold text-dark">
                                            <a asp-action="Details" asp-route-id="@a.Id" class="text-dark text-decoration-none">
                                                @a.Subject
                                            </a>
                                        </div>
                                        @if (!string.IsNullOrEmpty(a.Description))
                                        {
                                            <div class="small text-muted text-truncate" style="max-width: 250px;">
                                                @a.Description
                                            </div>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">
                                            @switch (a.Type)
                                            {
                                                case AcxiomCRM.Models.ActivityType.Call:
                                                    <i class="bi bi-telephone text-primary me-1"></i>
                                                    break;
                                                case AcxiomCRM.Models.ActivityType.Meeting:
                                                    <i class="bi bi-people text-info me-1"></i>
                                                    break;
                                                case AcxiomCRM.Models.ActivityType.Email:
                                                    <i class="bi bi-envelope text-warning me-1"></i>
                                                    break;
                                                case AcxiomCRM.Models.ActivityType.Task:
                                                    <i class="bi bi-check2-square text-success me-1"></i>
                                                    break;
                                                default:
                                                    <i class="bi bi-chat-text text-secondary me-1"></i>
                                                    break;
                                            }
                                            @a.Type
                                        </span>
                                    </td>
                                    <td>
                                        @switch (a.Status)
                                        {
                                            case AcxiomCRM.Models.ActivityStatus.Completed:
                                                <span class="badge bg-success-subtle text-success border border-success-subtle">Completed</span>
                                                break;
                                            case AcxiomCRM.Models.ActivityStatus.Planned:
                                                <span class="badge bg-info-subtle text-info border border-info-subtle">Planned</span>
                                                break;
                                            case AcxiomCRM.Models.ActivityStatus.Cancelled:
                                                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">Cancelled</span>
                                                break;
                                        }
                                    </td>
                                    <td>
                                        @if (a.CustomerId.HasValue)
                                        {
                                            <div>
                                                <a asp-controller="Customers" asp-action="Details" asp-route-id="@a.CustomerId.Value" class="text-primary text-decoration-none small fw-semibold">
                                                    <i class="bi bi-building me-1"></i>@a.CustomerName
                                                </a>
                                            </div>
                                        }
                                        @if (a.LeadId.HasValue)
                                        {
                                            <div>
                                                <a asp-controller="Leads" asp-action="Details" asp-route-id="@a.LeadId.Value" class="text-secondary text-decoration-none small">
                                                    <i class="bi bi-funnel me-1"></i>@a.LeadName
                                                </a>
                                            </div>
                                        }
                                        @if (a.OpportunityId.HasValue)
                                        {
                                            <div>
                                                <a asp-controller="Opportunities" asp-action="Details" asp-route-id="@a.OpportunityId.Value" class="text-info text-decoration-none small">
                                                    <i class="bi bi-currency-dollar me-1"></i>@a.OpportunityName
                                                </a>
                                            </div>
                                        }
                                    </td>
                                    <td>
                                        <div class="small fw-semibold text-dark">
                                            @a.ActivityDate.ToString("MMM dd, yyyy HH:mm")
                                        </div>
                                    </td>
                                    <td>
                                        <span class="small text-muted">@a.UserName</span>
                                    </td>
                                    <td class="text-end pe-3">
                                        <div class="btn-group btn-group-sm">
                                            <a asp-action="Details" asp-route-id="@a.Id" class="btn btn-outline-secondary" title="Details">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            @if (a.CanEdit)
                                            {
                                                <a asp-action="Edit" asp-route-id="@a.Id" class="btn btn-outline-primary" title="Edit">
                                                    <i class="bi bi-pencil"></i>
                                                </a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                @if (Model.TotalPages > 1)
                {
                    <div class="card-footer bg-white py-3 border-top d-flex justify-content-between align-items-center">
                        <div class="small text-muted">
                            Showing items @((Model.CurrentPage - 1) * Model.PageSize + 1) to @(Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalItems)) of @Model.TotalItems
                        </div>
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                                <a class="page-link" asp-action="Index"
                                   asp-route-Page="@(Model.CurrentPage - 1)"
                                   asp-route-PageSize="@Model.Filter.PageSize"
                                   asp-route-SearchTerm="@Model.Filter.SearchTerm"
                                   asp-route-Type="@Model.Filter.Type"
                                   asp-route-Status="@Model.Filter.Status"
                                   asp-route-UserId="@Model.Filter.UserId">
                                    Previous
                                </a>
                            </li>
                            @for (var p = 1; p <= Model.TotalPages; p++)
                            {
                                <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                                    <a class="page-link" asp-action="Index"
                                       asp-route-Page="@p"
                                       asp-route-PageSize="@Model.Filter.PageSize"
                                       asp-route-SearchTerm="@Model.Filter.SearchTerm"
                                       asp-route-Type="@Model.Filter.Type"
                                       asp-route-Status="@Model.Filter.Status"
                                       asp-route-UserId="@Model.Filter.UserId">
                                        @p
                                    </a>
                                </li>
                            }
                            <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                                <a class="page-link" asp-action="Index"
                                   asp-route-Page="@(Model.CurrentPage + 1)"
                                   asp-route-PageSize="@Model.Filter.PageSize"
                                   asp-route-SearchTerm="@Model.Filter.SearchTerm"
                                   asp-route-Type="@Model.Filter.Type"
                                   asp-route-Status="@Model.Filter.Status"
                                   asp-route-UserId="@Model.Filter.UserId">
                                    Next
                                </a>
                            </li>
                        </ul>
                    </div>
                }
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-clock-history text-muted display-4 d-block mb-3"></i>
                    <h5 class="fw-semibold text-dark">No Activities Found</h5>
                    <p class="text-muted small mb-3">No activity logs recorded matching your filters.</p>
                    <a asp-action="Create" class="btn btn-primary btn-sm">
                        <i class="bi bi-plus-circle me-1"></i> Log an Activity
                    </a>
                </div>
            }
        </div>
    </div>
</div>
