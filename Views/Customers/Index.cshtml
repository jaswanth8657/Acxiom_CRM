@model AcxiomCRM.ViewModels.Customers.CustomerListViewModel
@{
    ViewData["Title"] = "Customers";
}

<div class="container-fluid py-3">
    <!-- Header -->
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center pb-3 mb-3 border-bottom">
        <div>
            <h1 class="h3 fw-bold text-dark mb-1">
                <i class="bi bi-building text-primary me-2"></i>Customer Management
            </h1>
            <p class="text-muted mb-0 small">
                Manage accounts, corporate profiles, and sales assignments
            </p>
        </div>
        <div class="mt-3 mt-sm-0">
            <a asp-action="Create" class="btn btn-primary px-3 shadow-sm">
                <i class="bi bi-plus-circle me-1"></i> Add Customer
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Search & Filter Card -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3 p-md-4">
            <form method="get" asp-action="Index" class="row g-2 align-items-end">
                <div class="col-12 col-md-4 col-lg-4">
                    <label class="form-label small fw-semibold text-secondary">Search</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light text-muted"><i class="bi bi-search"></i></span>
                        <input type="text" name="SearchTerm" class="form-control" placeholder="Search by name, email, phone, company..." value="@Model.Filter.SearchTerm" />
                    </div>
                </div>

                <div class="col-6 col-md-3 col-lg-2">
                    <label class="form-label small fw-semibold text-secondary">Status</label>
                    <select name="Status" class="form-select">
                        <option value="">All Statuses</option>
                        <option value="Active" selected="@(Model.Filter.Status == AcxiomCRM.Models.CustomerStatus.Active)">Active</option>
                        <option value="Inactive" selected="@(Model.Filter.Status == AcxiomCRM.Models.CustomerStatus.Inactive)">Inactive</option>
                    </select>
                </div>

                @if (Model.CanManageAll && Model.AvailableUsers.Any())
                {
                    <div class="col-6 col-md-3 col-lg-3">
                        <label class="form-label small fw-semibold text-secondary">Assigned Executive</label>
                        <select name="AssignedToUserId" class="form-select">
                            <option value="">All Executives</option>
                            @foreach (var user in Model.AvailableUsers)
                            {
                                <option value="@user.Value" selected="@(Model.Filter.AssignedToUserId == user.Value)">@user.Text</option>
                            }
                        </select>
                    </div>
                }

                <div class="col-12 col-md-2 col-lg-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-funnel me-1"></i> Filter
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary" title="Clear Filters">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Customers Table Card -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <span class="fw-semibold text-dark">
                Total Records: <strong>@Model.TotalItems</strong>
            </span>
            <span class="text-muted small">
                Page @Model.CurrentPage of @(Model.TotalPages == 0 ? 1 : Model.TotalPages)
            </span>
        </div>
        <div class="card-body p-0">
            @if (Model.Customers.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light text-secondary small text-uppercase">
                            <tr>
                                <th class="ps-3">Code</th>
                                <th>Customer Name</th>
                                <th>Company</th>
                                <th>Contact Details</th>
                                <th>Assigned To</th>
                                <th>Status</th>
                                <th class="text-end pe-3">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Customers)
                            {
                                <tr>
                                    <td class="ps-3 fw-semibold text-primary">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none">
                                            @item.CustomerCode
                                        </a>
                                    </td>
                                    <td>
                                        <div class="fw-bold text-dark">@item.CustomerName</div>
                                        @if (!string.IsNullOrEmpty(item.City) || !string.IsNullOrEmpty(item.State))
                                        {
                                            <div class="text-muted small">@item.City, @item.State</div>
                                        }
                                    </td>
                                    <td>
                                        @(string.IsNullOrEmpty(item.CompanyName) ? "—" : item.CompanyName)
                                    </td>
                                    <td>
                                        <div class="small"><i class="bi bi-envelope me-1 text-muted"></i>@item.Email</div>
                                        <div class="small"><i class="bi bi-telephone me-1 text-muted"></i>@item.Phone</div>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">
                                            <i class="bi bi-person me-1"></i>@item.AssignedToUserName
                                        </span>
                                    </td>
                                    <td>
                                        @if (item.Status == AcxiomCRM.Models.CustomerStatus.Active)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle">
                                                <i class="bi bi-check-circle me-1"></i>Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">
                                                <i class="bi bi-dash-circle me-1"></i>Inactive
                                            </span>
                                        }
                                    </td>
                                    <td class="text-end pe-3">
                                        <div class="btn-group btn-group-sm">
                                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-secondary" title="View Details">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary" title="Edit Customer">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            @if (item.Status == AcxiomCRM.Models.CustomerStatus.Active)
                                            {
                                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger" title="Deactivate Customer">
                                                    <i class="bi bi-slash-circle"></i>
                                                </a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                @if (Model.TotalPages > 1)
                {
                    <div class="p-3 border-top d-flex justify-content-between align-items-center">
                        <div class="small text-muted">
                            Showing @(((Model.CurrentPage - 1) * Model.PageSize) + 1) to @(Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalItems)) of @Model.TotalItems customers
                        </div>
                        <nav aria-label="Customer list pagination">
                            <ul class="pagination pagination-sm mb-0">
                                <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                                    <a class="page-link" asp-action="Index" 
                                       asp-route-Page="@(Model.CurrentPage - 1)" 
                                       asp-route-SearchTerm="@Model.Filter.SearchTerm" 
                                       asp-route-Status="@Model.Filter.Status" 
                                       asp-route-AssignedToUserId="@Model.Filter.AssignedToUserId">
                                        Previous
                                    </a>
                                </li>

                                @for (int i = 1; i <= Model.TotalPages; i++)
                                {
                                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                        <a class="page-link" asp-action="Index" 
                                           asp-route-Page="@i" 
                                           asp-route-SearchTerm="@Model.Filter.SearchTerm" 
                                           asp-route-Status="@Model.Filter.Status" 
                                           asp-route-AssignedToUserId="@Model.Filter.AssignedToUserId">
                                            @i
                                        </a>
                                    </li>
                                }

                                <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                                    <a class="page-link" asp-action="Index" 
                                       asp-route-Page="@(Model.CurrentPage + 1)" 
                                       asp-route-SearchTerm="@Model.Filter.SearchTerm" 
                                       asp-route-Status="@Model.Filter.Status" 
                                       asp-route-AssignedToUserId="@Model.Filter.AssignedToUserId">
                                        Next
                                    </a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                }
            }
            else
            {
                <div class="p-5 text-center text-muted">
                    <i class="bi bi-inbox fs-1 mb-2 d-block text-secondary"></i>
                    <h5 class="fw-semibold">No customers found</h5>
                    <p class="small mb-3">No customer records matched your query or filter criteria.</p>
                    <a asp-action="Create" class="btn btn-sm btn-primary">
                        <i class="bi bi-plus-circle me-1"></i> Create First Customer
                    </a>
                </div>
            }
        </div>
    </div>
</div>
