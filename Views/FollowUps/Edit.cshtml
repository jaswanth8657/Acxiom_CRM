@model AcxiomCRM.ViewModels.FollowUps.FollowUpEditViewModel
@{
    ViewData["Title"] = $"Edit Follow-Up - {Model.Subject}";
}

<div class="container-fluid py-3">
    <!-- Breadcrumb & Header -->
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-2 small">
            <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Follow-Ups</a></li>
            <li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@Model.Id" class="text-decoration-none">@Model.Subject</a></li>
            <li class="breadcrumb-item active" aria-current="page">Edit</li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-center pb-3 mb-4 border-bottom">
        <div>
            <h1 class="h3 fw-bold text-dark mb-0">Edit / Reschedule Follow-Up</h1>
            <p class="text-muted mb-0 small">Update task details, reschedule dates, or modify CRM record associations</p>
        </div>
        <div>
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Back to Details
            </a>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-12 col-lg-8">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-body p-4">
                    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" id="editFollowUpForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <!-- 1. Task Details -->
                        <h5 class="fw-bold text-dark border-bottom pb-2 mb-3">
                            <i class="bi bi-calendar-event text-primary me-2"></i>Task Information
                        </h5>

                        <div class="row g-3 mb-4">
                            <div class="col-12">
                                <label asp-for="Subject" class="form-label fw-semibold text-secondary"></label>
                                <input asp-for="Subject" class="form-control" />
                                <span asp-validation-for="Subject" class="text-danger small"></span>
                            </div>

                            <div class="col-12 col-md-6">
                                <label asp-for="ScheduledDate" class="form-label fw-semibold text-secondary"></label>
                                <input asp-for="ScheduledDate" class="form-control" type="datetime-local" value="@Model.ScheduledDate.ToString("yyyy-MM-ddTHH:mm")" />
                                <span asp-validation-for="ScheduledDate" class="text-danger small"></span>
                            </div>

                            <div class="col-12 col-md-3">
                                <label asp-for="Type" class="form-label fw-semibold text-secondary"></label>
                                <select asp-for="Type" class="form-select" asp-items="Html.GetEnumSelectList<AcxiomCRM.Models.FollowUpType>()"></select>
                                <span asp-validation-for="Type" class="text-danger small"></span>
                            </div>

                            <div class="col-12 col-md-3">
                                <label asp-for="Priority" class="form-label fw-semibold text-secondary"></label>
                                <select asp-for="Priority" class="form-select" asp-items="Html.GetEnumSelectList<AcxiomCRM.Models.FollowUpPriority>()"></select>
                                <span asp-validation-for="Priority" class="text-danger small"></span>
                            </div>

                            <div class="col-12 col-md-6">
                                <label asp-for="Status" class="form-label fw-semibold text-secondary"></label>
                                <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<AcxiomCRM.Models.FollowUpStatus>()"></select>
                                <span asp-validation-for="Status" class="text-danger small"></span>
                            </div>

                            <div class="col-12 col-md-6">
                                <label asp-for="ChangeReason" class="form-label fw-semibold text-secondary"></label>
                                <input asp-for="ChangeReason" class="form-control" placeholder="Optional explanation for reschedule/edit" />
                                <span asp-validation-for="ChangeReason" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- 2. Related Entities -->
                        <h5 class="fw-bold text-dark border-bottom pb-2 mb-3">
                            <i class="bi bi-link-45deg text-primary me-2"></i>CRM Associations
                        </h5>

                        <div class="row g-3 mb-4">
                            <div class="col-12 col-md-4">
                                <label asp-for="CustomerId" class="form-label fw-semibold text-secondary"></label>
                                <select asp-for="CustomerId" class="form-select" asp-items="Model.AvailableCustomers">
                                    <option value="">-- None / Select Customer --</option>
                                </select>
                                <span asp-validation-for="CustomerId" class="text-danger small"></span>
                            </div>

                            <div class="col-12 col-md-4">
                                <label asp-for="LeadId" class="form-label fw-semibold text-secondary"></label>
                                <select asp-for="LeadId" class="form-select" asp-items="Model.AvailableLeads">
                                    <option value="">-- None / Select Lead --</option>
                                </select>
                                <span asp-validation-for="LeadId" class="text-danger small"></span>
                            </div>

                            <div class="col-12 col-md-4">
                                <label asp-for="OpportunityId" class="form-label fw-semibold text-secondary"></label>
                                <select asp-for="OpportunityId" class="form-select" asp-items="Model.AvailableOpportunities">
                                    <option value="">-- None / Select Opportunity --</option>
                                </select>
                                <span asp-validation-for="OpportunityId" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- 3. Assignment & Notes -->
                        <h5 class="fw-bold text-dark border-bottom pb-2 mb-3">
                            <i class="bi bi-person-check text-primary me-2"></i>Assignment & Notes
                        </h5>

                        <div class="row g-3 mb-4">
                            @if (Model.CanAssignAny && Model.AvailableUsers.Any())
                            {
                                <div class="col-12 col-md-6">
                                    <label asp-for="AssignedToUserId" class="form-label fw-semibold text-secondary"></label>
                                    <select asp-for="AssignedToUserId" class="form-select" asp-items="Model.AvailableUsers">
                                    </select>
                                    <span asp-validation-for="AssignedToUserId" class="text-danger small"></span>
                                </div>
                            }

                            <div class="col-12">
                                <label asp-for="Notes" class="form-label fw-semibold text-secondary"></label>
                                <textarea asp-for="Notes" class="form-control" rows="4"></textarea>
                                <span asp-validation-for="Notes" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 border-top pt-3">
                            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a>
                            <button type="submit" class="btn btn-primary px-4">
                                <i class="bi bi-check-lg me-1"></i> Save Changes
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
