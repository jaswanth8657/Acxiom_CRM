@model AcxiomCRM.ViewModels.FollowUps.FollowUpListViewModel
@{
    ViewData["Title"] = "Follow-Ups";
}

<div class="container-fluid py-3">
    <!-- Header -->
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center pb-3 mb-3 border-bottom">
        <div>
            <h1 class="h3 fw-bold text-dark mb-1">
                <i class="bi bi-calendar-check text-primary me-2"></i>Follow-Up Management
            </h1>
            <p class="text-muted mb-0 small">
                Schedule calls, meetings, tasks, and track pending interactions across customers and leads
            </p>
        </div>
        <div class="mt-3 mt-sm-0">
            <a asp-action="Create" class="btn btn-primary px-3 shadow-sm">
                <i class="bi bi-plus-circle me-1"></i> Schedule Follow-Up
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Follow-Up Summary Cards -->
    <div class="row g-2 mb-4">
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm border-start border-info border-3 text-center p-3 rounded-3 bg-light h-100">
                <div class="text-muted small fw-semibold text-uppercase">Upcoming</div>
                <div class="h3 fw-bold text-info my-1">@Model.UpcomingCount</div>
                <small class="text-muted">Future scheduled tasks</small>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm border-start border-primary border-3 text-center p-3 rounded-3 bg-light h-100">
                <div class="text-muted small fw-semibold text-uppercase">Due Today</div>
                <div class="h3 fw-bold text-primary my-1">@Model.TodayCount</div>
                <small class="text-muted">Needs attention today</small>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm border-start border-danger border-3 text-center p-3 rounded-3 bg-light h-100">
                <div class="text-muted small fw-semibold text-uppercase">Overdue / Missed</div>
                <div class="h3 fw-bold text-danger my-1">@Model.OverdueCount</div>
                <small class="text-muted">Missed or past due date</small>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm border-start border-success border-3 text-center p-3 rounded-3 bg-light h-100">
                <div class="text-muted small fw-semibold text-uppercase">Completed</div>
                <div class="h3 fw-bold text-success my-1">@Model.CompletedCount</div>
                <small class="text-muted">Successfully closed</small>
            </div>
        </div>
    </div>

    <!-- Search & Filter Card -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3 p-md-4">
            <form method="get" asp-action="Index" class="row g-2 align-items-end">
                <div class="col-12 col-md-3">
                    <label class="form-label small fw-semibold text-secondary">Search</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light text-muted"><i class="bi bi-search"></i></span>
                        <input type="text" name="SearchTerm" class="form-control" placeholder="Subject, remarks, customer..." value="@Model.Filter.SearchTerm" />
                    </div>
                </div>

                <div class="col-6 col-md-2">
                    <label class="form-label small fw-semibold text-secondary">Status</label>
                    <select name="Status" class="form-select">
                        <option value="">All Statuses</option>
                        @foreach (var s in Model.AvailableStatuses)
                        {
                            <option value="@s.Value" selected="@(s.Selected)">@s.Text</option>
                        }
                    </select>
                </div>

                <div class="col-6 col-md-2">
                    <label class="form-label small fw-semibold text-secondary">Type</label>
                    <select name="Type" class="form-select">
                        <option value="">All Types</option>
                        @foreach (var t in Model.AvailableTypes)
                        {
                            <option value="@t.Value" selected="@(t.Selected)">@t.Text</option>
                        }
                    </select>
                </div>

                @if (Model.CanManageAll && Model.AvailableUsers.Any())
                {
                    <div class="col-6 col-md-2">
                        <label class="form-label small fw-semibold text-secondary">Assigned User</label>
                        <select name="AssignedToUserId" class="form-select">
                            <option value="">All Team Members</option>
                            @foreach (var u in Model.AvailableUsers)
                            {
                                <option value="@u.Value" selected="@(u.Selected)">@u.Text</option>
                            }
                        </select>
                    </div>
                }

                <div class="col-6 col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary flex-grow-1">
                        <i class="bi bi-filter me-1"></i> Apply Filter
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Follow-Ups List Table -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <h5 class="card-title mb-0 fw-semibold text-dark">
                Follow-Up Tasks (@Model.TotalItems)
            </h5>
            <span class="text-muted small">Page @Model.CurrentPage of @(Model.TotalPages == 0 ? 1 : Model.TotalPages)</span>
        </div>
        <div class="card-body p-0">
            @if (Model.FollowUps.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3 text-secondary small fw-semibold">Subject / Task</th>
                                <th class="text-secondary small fw-semibold">Type</th>
                                <th class="text-secondary small fw-semibold">Related Record</th>
                                <th class="text-secondary small fw-semibold">Scheduled Date</th>
                                <th class="text-secondary small fw-semibold">Assigned To</th>
                                <th class="text-secondary small fw-semibold">Status</th>
                                <th class="text-end pe-3 text-secondary small fw-semibold">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var f in Model.FollowUps)
                            {
                                <tr>
                                    <td class="ps-3">
                                        <div class="fw-semibold text-dark">
                                            <a asp-action="Details" asp-route-id="@f.Id" class="text-dark text-decoration-none">
                                                @f.Subject
                                            </a>
                                        </div>
                                        @if (!string.IsNullOrEmpty(f.Notes))
                                        {
                                            <div class="small text-muted text-truncate" style="max-width: 250px;">
                                                @f.Notes
                                            </div>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">
                                            @switch (f.Type)
                                            {
                                                case AcxiomCRM.Models.FollowUpType.Call:
                                                    <i class="bi bi-telephone text-primary me-1"></i>
                                                    break;
                                                case AcxiomCRM.Models.FollowUpType.Meeting:
                                                    <i class="bi bi-people text-info me-1"></i>
                                                    break;
                                                case AcxiomCRM.Models.FollowUpType.Email:
                                                    <i class="bi bi-envelope text-warning me-1"></i>
                                                    break;
                                                case AcxiomCRM.Models.FollowUpType.Task:
                                                    <i class="bi bi-check2-square text-success me-1"></i>
                                                    break;
                                                default:
                                                    <i class="bi bi-card-checklist text-secondary me-1"></i>
                                                    break;
                                            }
                                            @f.Type
                                        </span>
                                    </td>
                                    <td>
                                        @if (f.CustomerId.HasValue)
                                        {
                                            <div>
                                                <a asp-controller="Customers" asp-action="Details" asp-route-id="@f.CustomerId.Value" class="text-primary text-decoration-none small fw-semibold">
                                                    <i class="bi bi-building me-1"></i>@f.CustomerName
                                                </a>
                                            </div>
                                        }
                                        @if (f.LeadId.HasValue)
                                        {
                                            <div>
                                                <a asp-controller="Leads" asp-action="Details" asp-route-id="@f.LeadId.Value" class="text-secondary text-decoration-none small">
                                                    <i class="bi bi-funnel me-1"></i>@f.LeadName
                                                </a>
                                            </div>
                                        }
                                        @if (f.OpportunityId.HasValue)
                                        {
                                            <div>
                                                <a asp-controller="Opportunities" asp-action="Details" asp-route-id="@f.OpportunityId.Value" class="text-info text-decoration-none small">
                                                    <i class="bi bi-currency-dollar me-1"></i>@f.OpportunityName
                                                </a>
                                            </div>
                                        }
                                    </td>
                                    <td>
                                        <div class="fw-semibold @(f.ScheduledDate < DateTime.Now && f.Status == AcxiomCRM.Models.FollowUpStatus.Planned ? "text-danger" : "text-dark")">
                                            @f.ScheduledDate.ToString("MMM dd, yyyy HH:mm")
                                        </div>
                                    </td>
                                    <td>
                                        <span class="small text-muted">@f.AssignedToUserName</span>
                                    </td>
                                    <td>
                                        @switch (f.Status)
                                        {
                                            case AcxiomCRM.Models.FollowUpStatus.Planned:
                                                if (f.ScheduledDate.Date < DateTime.Today)
                                                {
                                                    <span class="badge bg-danger">Overdue</span>
                                                }
                                                else if (f.ScheduledDate.Date == DateTime.Today)
                                                {
                                                    <span class="badge bg-warning text-dark">Due Today</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-info text-dark">Planned</span>
                                                }
                                                break;
                                            case AcxiomCRM.Models.FollowUpStatus.Completed:
                                                <span class="badge bg-success"><i class="bi bi-check2 me-1"></i>Completed</span>
                                                break;
                                            case AcxiomCRM.Models.FollowUpStatus.Missed:
                                                <span class="badge bg-danger">Missed</span>
                                                break;
                                            case AcxiomCRM.Models.FollowUpStatus.Cancelled:
                                                <span class="badge bg-secondary">Cancelled</span>
                                                break;
                                        }
                                    </td>
                                    <td class="text-end pe-3">
                                        <div class="btn-group btn-group-sm">
                                            <a asp-action="Details" asp-route-id="@f.Id" class="btn btn-outline-secondary" title="Details">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            @if (f.CanEdit)
                                            {
                                                <a asp-action="Edit" asp-route-id="@f.Id" class="btn btn-outline-primary" title="Edit / Reschedule">
                                                    <i class="bi bi-pencil"></i>
                                                </a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                @if (Model.TotalPages > 1)
                {
                    <div class="card-footer bg-white py-3 border-top d-flex justify-content-between align-items-center">
                        <div class="small text-muted">
                            Showing items @((Model.CurrentPage - 1) * Model.PageSize + 1) to @(Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalItems)) of @Model.TotalItems
                        </div>
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                                <a class="page-link" asp-action="Index"
                                   asp-route-Page="@(Model.CurrentPage - 1)"
                                   asp-route-PageSize="@Model.Filter.PageSize"
                                   asp-route-SearchTerm="@Model.Filter.SearchTerm"
                                   asp-route-Status="@Model.Filter.Status"
                                   asp-route-Type="@Model.Filter.Type"
                                   asp-route-AssignedToUserId="@Model.Filter.AssignedToUserId">
                                    Previous
                                </a>
                            </li>
                            @for (var p = 1; p <= Model.TotalPages; p++)
                            {
                                <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                                    <a class="page-link" asp-action="Index"
                                       asp-route-Page="@p"
                                       asp-route-PageSize="@Model.Filter.PageSize"
                                       asp-route-SearchTerm="@Model.Filter.SearchTerm"
                                       asp-route-Status="@Model.Filter.Status"
                                       asp-route-Type="@Model.Filter.Type"
                                       asp-route-AssignedToUserId="@Model.Filter.AssignedToUserId">
                                        @p
                                    </a>
                                </li>
                            }
                            <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                                <a class="page-link" asp-action="Index"
                                   asp-route-Page="@(Model.CurrentPage + 1)"
                                   asp-route-PageSize="@Model.Filter.PageSize"
                                   asp-route-SearchTerm="@Model.Filter.SearchTerm"
                                   asp-route-Status="@Model.Filter.Status"
                                   asp-route-Type="@Model.Filter.Type"
                                   asp-route-AssignedToUserId="@Model.Filter.AssignedToUserId">
                                    Next
                                </a>
                            </li>
                        </ul>
                    </div>
                }
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-calendar-x text-muted display-4 d-block mb-3"></i>
                    <h5 class="fw-semibold text-dark">No Follow-Ups Found</h5>
                    <p class="text-muted small mb-3">No follow-ups matched your criteria.</p>
                    <a asp-action="Create" class="btn btn-primary btn-sm">
                        <i class="bi bi-plus-circle me-1"></i> Schedule a Follow-Up
                    </a>
                </div>
            }
        </div>
    </div>
</div>
