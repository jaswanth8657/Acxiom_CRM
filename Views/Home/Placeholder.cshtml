@{
    ViewData["Title"] = ViewBag.ModuleName;
}

<div class="container py-4">
    <div class="card shadow-sm border-0">
        <div class="card-body p-5 text-center">
            <div class="mb-3 text-primary">
                <i class="bi bi-gear-wide-connected" style="font-size: 3rem;"></i>
            </div>
            <h2 class="h3 fw-bold mb-2">@ViewBag.ModuleName Module</h2>
            <p class="text-muted mb-4">
                The foundation for the <strong>@ViewBag.ModuleName</strong> module is prepared in the database schema.
                Full business workflows and CRUD operations will be activated in subsequent phases according to project requirements.
            </p>
            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary px-4">
                <i class="bi bi-speedometer2 me-1"></i> Return to Dashboard
            </a>
        </div>
    </div>
</div>
