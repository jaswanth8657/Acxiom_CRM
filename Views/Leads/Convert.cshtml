@model AcxiomCRM.ViewModels.Leads.LeadConvertViewModel
@{
    ViewData["Title"] = $"Convert Lead - {Model.LeadName}";
}

<div class="container-fluid py-3">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-2 small">
            <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Leads</a></li>
            <li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@Model.LeadId" class="text-decoration-none">@Model.LeadCode</a></li>
            <li class="breadcrumb-item active" aria-current="page">Convert</li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-center pb-3 mb-4 border-bottom">
        <div>
            <h1 class="h3 fw-bold text-dark mb-1">
                <i class="bi bi-arrow-repeat text-success me-2"></i>Convert Qualified Lead
            </h1>
            <p class="text-muted mb-0 small">
                Transform this verified prospect into an active Customer Account and Sales Pipeline Opportunity
            </p>
        </div>
        <a asp-action="Details" asp-route-id="@Model.LeadId" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Back to Lead
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-12 col-xl-10">
            <!-- Business Workflow Explanation Card -->
            <div class="card border-0 shadow-sm bg-light rounded-3 mb-4 border-start border-success border-4">
                <div class="card-body p-3 p-md-4">
                    <h6 class="fw-bold text-dark mb-2">
                        <i class="bi bi-info-circle text-success me-2"></i>What happens during conversion?
                    </h6>
                    <div class="row g-3 small text-secondary">
                        <div class="col-md-4">
                            <div class="d-flex align-items-start gap-2">
                                <span class="badge bg-success rounded-circle p-1">1</span>
                                <div>
                                    <strong class="text-dark d-block">Account Creation / Linking</strong>
                                    A Customer Account is created with @Model.LeadName's contact information. If email/phone already matches an existing customer, the account is linked without duplicating records.
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="d-flex align-items-start gap-2">
                                <span class="badge bg-success rounded-circle p-1">2</span>
                                <div>
                                    <strong class="text-dark d-block">Deal Generation</strong>
                                    A new Opportunity is added to your active Sales Pipeline under the Customer Account.
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="d-flex align-items-start gap-2">
                                <span class="badge bg-success rounded-circle p-1">3</span>
                                <div>
                                    <strong class="text-dark d-block">Audit & Lock</strong>
                                    The lead is marked as <strong>Converted</strong>, linked to the new records, and preserved in the audit trail.
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Conversion Form -->
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0 fw-semibold text-dark">Conversion Parameters</h5>
                    <span class="badge bg-light text-primary border">Lead: @Model.LeadCode</span>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Convert" asp-route-id="@Model.LeadId" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="LeadId" />
                        <input type="hidden" asp-for="LeadCode" />
                        <input type="hidden" asp-for="LeadName" />
                        <input type="hidden" asp-for="Email" />
                        <input type="hidden" asp-for="Phone" />
                        <input type="hidden" asp-for="CompanyName" />
                        <input type="hidden" asp-for="ExpectedValue" />
                        <input type="hidden" asp-for="AssignedToUserId" />

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

                        <!-- Lead Summary Box -->
                        <div class="bg-light p-3 rounded-3 border mb-4">
                            <h6 class="fw-semibold text-dark mb-2">Lead Information to be Transferred:</h6>
                            <div class="row g-2 small">
                                <div class="col-sm-6 col-md-3">
                                    <span class="text-muted">Contact:</span> <strong>@Model.LeadName</strong>
                                </div>
                                <div class="col-sm-6 col-md-3">
                                    <span class="text-muted">Company:</span> <strong>@(string.IsNullOrEmpty(Model.CompanyName) ? "N/A" : Model.CompanyName)</strong>
                                </div>
                                <div class="col-sm-6 col-md-3">
                                    <span class="text-muted">Email:</span> <strong>@Model.Email</strong>
                                </div>
                                <div class="col-sm-6 col-md-3">
                                    <span class="text-muted">Phone:</span> <strong>@(string.IsNullOrEmpty(Model.Phone) ? "N/A" : Model.Phone)</strong>
                                </div>
                            </div>
                        </div>

                        <h6 class="fw-bold text-dark mb-3">
                            <i class="bi bi-briefcase text-primary me-2"></i>New Opportunity Details
                        </h6>

                        <!-- Row 1: Opportunity Title & Amount -->
                        <div class="row g-3 mb-3">
                            <div class="col-md-7">
                                <label asp-for="OpportunityTitle" class="form-label fw-semibold text-secondary small">Deal / Opportunity Title <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-tag"></i></span>
                                    <input asp-for="OpportunityTitle" class="form-control" placeholder="e.g. Acme Corp - Enterprise License Deal" />
                                </div>
                                <span asp-validation-for="OpportunityTitle" class="text-danger small"></span>
                            </div>

                            <div class="col-md-5">
                                <label asp-for="OpportunityAmount" class="form-label fw-semibold text-secondary small">Opportunity Value ($) <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light">$</span>
                                    <input asp-for="OpportunityAmount" class="form-control" type="number" step="0.01" min="0" />
                                </div>
                                <span asp-validation-for="OpportunityAmount" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Row 2: Stage & Close Date -->
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="OpportunityStage" class="form-label fw-semibold text-secondary small">Initial Pipeline Stage</label>
                                <select asp-for="OpportunityStage" class="form-select">
                                    <option value="Prospecting" selected>Prospecting</option>
                                    <option value="Qualification">Qualification</option>
                                    <option value="Proposal">Proposal</option>
                                    <option value="Negotiation">Negotiation</option>
                                </select>
                                <span asp-validation-for="OpportunityStage" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="ExpectedCloseDate" class="form-label fw-semibold text-secondary small">Estimated Target Close Date <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-calendar-event"></i></span>
                                    <input asp-for="ExpectedCloseDate" class="form-control" type="date" value="@(Model.ExpectedCloseDate.HasValue ? Model.ExpectedCloseDate.Value.ToString("yyyy-MM-dd") : DateTime.Today.AddDays(30).ToString("yyyy-MM-dd"))" />
                                </div>
                                <span asp-validation-for="ExpectedCloseDate" class="text-danger small"></span>
                            </div>
                        </div>

                        <hr class="my-4" />

                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="Details" asp-route-id="@Model.LeadId" class="btn btn-outline-secondary px-4">Cancel</a>
                            <button type="submit" class="btn btn-success px-4 shadow-sm">
                                <i class="bi bi-arrow-repeat me-1"></i> Complete Conversion
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
