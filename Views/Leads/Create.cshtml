@model AcxiomCRM.ViewModels.Leads.LeadCreateViewModel
@{
    ViewData["Title"] = "Create Lead";
}

<div class="container-fluid py-3">
    <!-- Breadcrumb & Header -->
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-2 small">
            <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Leads</a></li>
            <li class="breadcrumb-item active" aria-current="page">Create New Lead</li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-center pb-3 mb-4 border-bottom">
        <div>
            <h1 class="h3 fw-bold text-dark mb-1">
                <i class="bi bi-funnel-fill text-primary me-2"></i>Create New Lead
            </h1>
            <p class="text-muted mb-0 small">Enter prospect details to initiate sales follow-ups and tracking</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Back to List
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-12 col-xl-10">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white py-3 border-bottom">
                    <h5 class="card-title mb-0 fw-semibold text-dark">Lead Information</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

                        <!-- Row 1: Identification -->
                        <div class="row g-3 mb-3">
                            <div class="col-md-4">
                                <label asp-for="LeadCode" class="form-label fw-semibold text-secondary small"></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-upc-scan"></i></span>
                                    <input asp-for="LeadCode" class="form-control" placeholder="Auto-generated" />
                                </div>
                                <span asp-validation-for="LeadCode" class="text-danger small"></span>
                            </div>

                            <div class="col-md-8">
                                <label asp-for="LeadName" class="form-label fw-semibold text-secondary small">Lead Name <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-person"></i></span>
                                    <input asp-for="LeadName" class="form-control" placeholder="Full contact name" />
                                </div>
                                <span asp-validation-for="LeadName" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Row 2: Contact Information -->
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label fw-semibold text-secondary small">Email Address <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-envelope"></i></span>
                                    <input asp-for="Email" class="form-control" placeholder="prospect@company.com" type="email" />
                                </div>
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Phone" class="form-label fw-semibold text-secondary small">Phone Number</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-telephone"></i></span>
                                    <input asp-for="Phone" class="form-control" placeholder="+1 (555) 123-4567" />
                                </div>
                                <span asp-validation-for="Phone" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Row 3: Corporate Info -->
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="CompanyName" class="form-label fw-semibold text-secondary small"></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-building"></i></span>
                                    <input asp-for="CompanyName" class="form-control" placeholder="Company or organization" />
                                </div>
                                <span asp-validation-for="CompanyName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Title" class="form-label fw-semibold text-secondary small">Professional Title</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-briefcase"></i></span>
                                    <input asp-for="Title" class="form-control" placeholder="e.g. Procurement Director, VP Sales" />
                                </div>
                                <span asp-validation-for="Title" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Row 4: Deal Pipeline Parameters -->
                        <div class="row g-3 mb-4">
                            <div class="col-md-4">
                                <label asp-for="Source" class="form-label fw-semibold text-secondary small">Lead Source <span class="text-danger">*</span></label>
                                <select asp-for="Source" class="form-select">
                                    @foreach (var s in Model.AvailableSources)
                                    {
                                        <option value="@s.Value" selected="@(Model.Source == s.Value)">@s.Text</option>
                                    }
                                </select>
                                <span asp-validation-for="Source" class="text-danger small"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="ExpectedValue" class="form-label fw-semibold text-secondary small"></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light">$</span>
                                    <input asp-for="ExpectedValue" class="form-control" placeholder="10000.00" type="number" step="0.01" min="0" />
                                </div>
                                <span asp-validation-for="ExpectedValue" class="text-danger small"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="Status" class="form-label fw-semibold text-secondary small">Initial Status <span class="text-danger">*</span></label>
                                <select asp-for="Status" class="form-select">
                                    <option value="New" selected>New</option>
                                    <option value="Contacted">Contacted</option>
                                    <option value="Qualified">Qualified</option>
                                    <option value="Unqualified">Unqualified</option>
                                </select>
                                <span asp-validation-for="Status" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Row 5: Assignment -->
                        @if (Model.AvailableUsers.Any())
                        {
                            <div class="row g-3 mb-4">
                                <div class="col-md-6">
                                    <label asp-for="AssignedToUserId" class="form-label fw-semibold text-secondary small"></label>
                                    <select asp-for="AssignedToUserId" class="form-select">
                                        <option value="">-- Unassigned --</option>
                                        @foreach (var u in Model.AvailableUsers)
                                        {
                                            <option value="@u.Value" selected="@(Model.AssignedToUserId == u.Value)">@u.Text</option>
                                        }
                                    </select>
                                    <span asp-validation-for="AssignedToUserId" class="text-danger small"></span>
                                </div>
                            </div>
                        }
                        else
                        {
                            <input type="hidden" asp-for="AssignedToUserId" />
                        }

                        <hr class="my-4" />

                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancel</a>
                            <button type="submit" class="btn btn-primary px-4 shadow-sm">
                                <i class="bi bi-check2-circle me-1"></i> Save Lead
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
