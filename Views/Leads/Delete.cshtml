@model AcxiomCRM.Models.Lead
@{
    ViewData["Title"] = $"Delete Lead - {Model.LeadCode}";
}

<div class="container-fluid py-3">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-2 small">
            <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Leads</a></li>
            <li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@Model.Id" class="text-decoration-none">@Model.LeadCode</a></li>
            <li class="breadcrumb-item active" aria-current="page">Delete</li>
        </ol>
    </nav>

    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-danger text-white py-3">
                    <h5 class="card-title mb-0 fw-semibold">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>Confirm Lead Deletion
                    </h5>
                </div>
                <div class="card-body p-4">
                    <div class="alert alert-warning mb-4" role="alert">
                        <strong>Warning:</strong> You are about to permanently delete lead <strong>@Model.LeadName</strong> (@Model.LeadCode). This will also remove any associated activities and follow-ups.
                    </div>

                    <dl class="row mb-4">
                        <dt class="col-sm-4 text-muted small">Lead Code</dt>
                        <dd class="col-sm-8 fw-semibold">@Model.LeadCode</dd>

                        <dt class="col-sm-4 text-muted small">Lead Name</dt>
                        <dd class="col-sm-8 fw-semibold">@Model.LeadName</dd>

                        <dt class="col-sm-4 text-muted small">Email</dt>
                        <dd class="col-sm-8">@Model.Email</dd>

                        <dt class="col-sm-4 text-muted small">Company</dt>
                        <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.CompanyName) ? "-" : Model.CompanyName)</dd>

                        <dt class="col-sm-4 text-muted small">Status</dt>
                        <dd class="col-sm-8">
                            <span class="badge bg-secondary">@Model.Status</span>
                        </dd>

                        <dt class="col-sm-4 text-muted small">Expected Value</dt>
                        <dd class="col-sm-8 fw-semibold text-success">
                            @(Model.ExpectedValue.HasValue ? Model.ExpectedValue.Value.ToString("C") : "-")
                        </dd>
                    </dl>

                    <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
                        @Html.AntiForgeryToken()
                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary px-3">
                                Cancel
                            </a>
                            <button type="submit" class="btn btn-danger px-4 shadow-sm">
                                <i class="bi bi-trash me-1"></i> Permanently Delete
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
