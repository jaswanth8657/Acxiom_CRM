@model AcxiomCRM.ViewModels.Leads.LeadEditViewModel
@{
    ViewData["Title"] = $"Edit Lead - {Model.LeadCode}";
}

<div class="container-fluid py-3">
    <!-- Breadcrumb & Header -->
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-2 small">
            <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Leads</a></li>
            <li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@Model.Id" class="text-decoration-none">@Model.LeadCode</a></li>
            <li class="breadcrumb-item active" aria-current="page">Edit</li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-center pb-3 mb-4 border-bottom">
        <div>
            <h1 class="h3 fw-bold text-dark mb-1">
                <i class="bi bi-pencil-square text-primary me-2"></i>Edit Lead: @Model.LeadName
            </h1>
            <p class="text-muted mb-0 small">Update contact details, sales pipeline progression, and account owner</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-eye me-1"></i> View Details
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Back to List
            </a>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-12 col-xl-10">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0 fw-semibold text-dark">Lead Profile & Progression</h5>
                    <span class="badge bg-light text-primary border px-3 py-2 fs-6">
                        Code: @Model.LeadCode
                    </span>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="LeadCode" />
                        <input type="hidden" asp-for="CurrentStatus" />

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

                        <!-- Row 1: Identification & Name -->
                        <div class="row g-3 mb-3">
                            <div class="col-md-4">
                                <label class="form-label fw-semibold text-secondary small">Lead Code</label>
                                <input type="text" class="form-control bg-light" value="@Model.LeadCode" readonly />
                            </div>

                            <div class="col-md-8">
                                <label asp-for="LeadName" class="form-label fw-semibold text-secondary small">Lead Name <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-person"></i></span>
                                    <input asp-for="LeadName" class="form-control" />
                                </div>
                                <span asp-validation-for="LeadName" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Row 2: Contact Information -->
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label fw-semibold text-secondary small">Email Address <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-envelope"></i></span>
                                    <input asp-for="Email" class="form-control" type="email" />
                                </div>
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Phone" class="form-label fw-semibold text-secondary small">Phone Number</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-telephone"></i></span>
                                    <input asp-for="Phone" class="form-control" />
                                </div>
                                <span asp-validation-for="Phone" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Row 3: Corporate Info -->
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="CompanyName" class="form-label fw-semibold text-secondary small"></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-building"></i></span>
                                    <input asp-for="CompanyName" class="form-control" />
                                </div>
                                <span asp-validation-for="CompanyName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Title" class="form-label fw-semibold text-secondary small">Job Title</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-briefcase"></i></span>
                                    <input asp-for="Title" class="form-control" />
                                </div>
                                <span asp-validation-for="Title" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Row 4: Pipeline Parameters -->
                        <div class="row g-3 mb-3">
                            <div class="col-md-4">
                                <label asp-for="Source" class="form-label fw-semibold text-secondary small">Lead Source <span class="text-danger">*</span></label>
                                <select asp-for="Source" class="form-select">
                                    @foreach (var s in Model.AvailableSources)
                                    {
                                        <option value="@s.Value" selected="@(Model.Source == s.Value)">@s.Text</option>
                                    }
                                </select>
                                <span asp-validation-for="Source" class="text-danger small"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="ExpectedValue" class="form-label fw-semibold text-secondary small"></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light">$</span>
                                    <input asp-for="ExpectedValue" class="form-control" type="number" step="0.01" min="0" />
                                </div>
                                <span asp-validation-for="ExpectedValue" class="text-danger small"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="Status" class="form-label fw-semibold text-secondary small">Pipeline Status <span class="text-danger">*</span></label>
                                <select asp-for="Status" class="form-select">
                                    @foreach (var st in Model.AllowedStatuses)
                                    {
                                        <option value="@st.Value" selected="@(st.Selected)">@st.Text</option>
                                    }
                                </select>
                                <span asp-validation-for="Status" class="text-danger small"></span>
                                <small class="text-muted d-block mt-1">Allowed transitions based on business workflow</small>
                            </div>
                        </div>

                        <!-- Status change note -->
                        <div class="mb-3">
                            <label asp-for="StatusChangeNote" class="form-label fw-semibold text-secondary small"></label>
                            <input asp-for="StatusChangeNote" class="form-control" placeholder="Optional notes explaining status transition or qualification criteria" />
                            <span asp-validation-for="StatusChangeNote" class="text-danger small"></span>
                        </div>

                        <!-- Reassignment -->
                        @if (Model.CanReassign && Model.AvailableUsers.Any())
                        {
                            <div class="row g-3 mb-4">
                                <div class="col-md-6">
                                    <label asp-for="AssignedToUserId" class="form-label fw-semibold text-secondary small"></label>
                                    <select asp-for="AssignedToUserId" class="form-select">
                                        <option value="">-- Unassigned --</option>
                                        @foreach (var u in Model.AvailableUsers)
                                        {
                                            <option value="@u.Value" selected="@(Model.AssignedToUserId == u.Value)">@u.Text</option>
                                        }
                                    </select>
                                    <span asp-validation-for="AssignedToUserId" class="text-danger small"></span>
                                </div>
                            </div>
                        }
                        else
                        {
                            <input type="hidden" asp-for="AssignedToUserId" />
                        }

                        <hr class="my-4" />

                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary px-4">Cancel</a>
                            <button type="submit" class="btn btn-primary px-4 shadow-sm">
                                <i class="bi bi-check2-circle me-1"></i> Update Lead
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
