@model AcxiomCRM.ViewModels.Opportunities.OpportunityCreateViewModel
@{
    ViewData["Title"] = "Create Opportunity";
}

<div class="container-fluid py-3">
    <!-- Breadcrumb & Header -->
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-2 small">
            <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Opportunities</a></li>
            <li class="breadcrumb-item active" aria-current="page">Create New Opportunity</li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-center pb-3 mb-4 border-bottom">
        <div>
            <h1 class="h3 fw-bold text-dark mb-1">
                <i class="bi bi-currency-dollar text-primary me-2"></i>Create New Opportunity
            </h1>
            <p class="text-muted mb-0 small">Add a new revenue opportunity to the pipeline with stage and close date tracking</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Back to List
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-12 col-xl-10">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white py-3 border-bottom">
                    <h5 class="card-title mb-0 fw-semibold text-dark">Deal Information</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

                        <!-- Row 1: Deal Name & Customer -->
                        <div class="row g-3 mb-3">
                            <div class="col-md-7">
                                <label asp-for="OpportunityName" class="form-label fw-semibold text-secondary small">Opportunity Name <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-tag"></i></span>
                                    <input asp-for="OpportunityName" class="form-control" placeholder="e.g. Acme Corp - Enterprise License Deal" />
                                </div>
                                <span asp-validation-for="OpportunityName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-5">
                                <label asp-for="CustomerId" class="form-label fw-semibold text-secondary small">Customer Account <span class="text-danger">*</span></label>
                                <select asp-for="CustomerId" class="form-select">
                                    <option value="0">-- Select Customer --</option>
                                    @foreach (var c in Model.AvailableCustomers)
                                    {
                                        <option value="@c.Value" selected="@(Model.CustomerId.ToString() == c.Value)">@c.Text</option>
                                    }
                                </select>
                                <span asp-validation-for="CustomerId" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Row 2: Value, Stage, Probability -->
                        <div class="row g-3 mb-3">
                            <div class="col-md-4">
                                <label asp-for="Amount" class="form-label fw-semibold text-secondary small">Deal Amount ($) <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light">$</span>
                                    <input asp-for="Amount" class="form-control" type="number" step="0.01" min="0.01" placeholder="50000.00" />
                                </div>
                                <span asp-validation-for="Amount" class="text-danger small"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="Stage" class="form-label fw-semibold text-secondary small">Pipeline Stage <span class="text-danger">*</span></label>
                                <select asp-for="Stage" class="form-select">
                                    @foreach (var st in Model.AvailableStages)
                                    {
                                        <option value="@st.Value" selected="@(Model.Stage.ToString() == st.Text)">@st.Text</option>
                                    }
                                </select>
                                <span asp-validation-for="Stage" class="text-danger small"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="Probability" class="form-label fw-semibold text-secondary small">Win Probability (%) <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <input asp-for="Probability" class="form-control" type="number" min="0" max="100" />
                                    <span class="input-group-text bg-light">%</span>
                                </div>
                                <span asp-validation-for="Probability" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Row 3: Target Date & Related Lead -->
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="ExpectedCloseDate" class="form-label fw-semibold text-secondary small">Expected Close Date <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-calendar-event"></i></span>
                                    <input asp-for="ExpectedCloseDate" class="form-control" type="date" value="@Model.ExpectedCloseDate.ToString("yyyy-MM-dd")" />
                                </div>
                                <span asp-validation-for="ExpectedCloseDate" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="LeadId" class="form-label fw-semibold text-secondary small">Originating Lead (Optional)</label>
                                <select asp-for="LeadId" class="form-select">
                                    <option value="">-- None / Direct Opportunity --</option>
                                    @foreach (var l in Model.AvailableLeads)
                                    {
                                        <option value="@l.Value" selected="@(Model.LeadId.HasValue && Model.LeadId.Value.ToString() == l.Value)">@l.Text</option>
                                    }
                                </select>
                                <span asp-validation-for="LeadId" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Row 4: Assignment -->
                        @if (Model.AvailableUsers.Any())
                        {
                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <label asp-for="AssignedToUserId" class="form-label fw-semibold text-secondary small">Assigned Account Executive</label>
                                    <select asp-for="AssignedToUserId" class="form-select">
                                        <option value="">-- Unassigned --</option>
                                        @foreach (var u in Model.AvailableUsers)
                                        {
                                            <option value="@u.Value" selected="@(Model.AssignedToUserId == u.Value)">@u.Text</option>
                                        }
                                    </select>
                                    <span asp-validation-for="AssignedToUserId" class="text-danger small"></span>
                                </div>
                            </div>
                        }
                        else
                        {
                            <input type="hidden" asp-for="AssignedToUserId" />
                        }

                        <!-- Row 5: Notes -->
                        <div class="mb-4">
                            <label asp-for="Notes" class="form-label fw-semibold text-secondary small">Deal Notes & Requirements</label>
                            <textarea asp-for="Notes" class="form-control" rows="3" placeholder="Key customer objectives, requirements, competitive landscape..."></textarea>
                            <span asp-validation-for="Notes" class="text-danger small"></span>
                        </div>

                        <hr class="my-4" />

                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancel</a>
                            <button type="submit" class="btn btn-primary px-4 shadow-sm">
                                <i class="bi bi-check2-circle me-1"></i> Save Opportunity
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
