@model AcxiomCRM.ViewModels.Opportunities.OpportunityEditViewModel
@{
    ViewData["Title"] = $"Edit Opportunity - {Model.OpportunityName}";
}

<div class="container-fluid py-3">
    <!-- Breadcrumb & Header -->
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-2 small">
            <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Opportunities</a></li>
            <li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@Model.Id" class="text-decoration-none">@Model.OpportunityName</a></li>
            <li class="breadcrumb-item active" aria-current="page">Edit</li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-center pb-3 mb-4 border-bottom">
        <div>
            <h1 class="h3 fw-bold text-dark mb-1">
                <i class="bi bi-pencil-square text-primary me-2"></i>Edit Opportunity: @Model.OpportunityName
            </h1>
            <p class="text-muted mb-0 small">Update deal parameters, stage progression, and expected close date</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-eye me-1"></i> View Details
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Back to List
            </a>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-12 col-xl-10">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0 fw-semibold text-dark">Deal Progression Parameters</h5>
                    <span class="badge bg-light text-primary border">ID: #@Model.Id</span>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="CurrentStage" />

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

                        <!-- Row 1: Deal Name & Customer -->
                        <div class="row g-3 mb-3">
                            <div class="col-md-7">
                                <label asp-for="OpportunityName" class="form-label fw-semibold text-secondary small">Opportunity Name <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-tag"></i></span>
                                    <input asp-for="OpportunityName" class="form-control" />
                                </div>
                                <span asp-validation-for="OpportunityName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-5">
                                <label asp-for="CustomerId" class="form-label fw-semibold text-secondary small">Customer Account <span class="text-danger">*</span></label>
                                <select asp-for="CustomerId" class="form-select">
                                    @foreach (var c in Model.AvailableCustomers)
                                    {
                                        <option value="@c.Value" selected="@(Model.CustomerId.ToString() == c.Value)">@c.Text</option>
                                    }
                                </select>
                                <span asp-validation-for="CustomerId" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Row 2: Value, Stage, Probability -->
                        <div class="row g-3 mb-3">
                            <div class="col-md-4">
                                <label asp-for="Amount" class="form-label fw-semibold text-secondary small">Deal Amount ($) <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light">$</span>
                                    <input asp-for="Amount" class="form-control" type="number" step="0.01" min="0.01" />
                                </div>
                                <span asp-validation-for="Amount" class="text-danger small"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="Stage" class="form-label fw-semibold text-secondary small">Pipeline Stage <span class="text-danger">*</span></label>
                                <select asp-for="Stage" class="form-select">
                                    @foreach (var st in Model.AllowedStages)
                                    {
                                        <option value="@st.Value" selected="@(st.Selected)">@st.Text</option>
                                    }
                                </select>
                                <span asp-validation-for="Stage" class="text-danger small"></span>
                                <small class="text-muted d-block mt-1">Allowed transitions according to sales governance</small>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="Probability" class="form-label fw-semibold text-secondary small">Win Probability (%) <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <input asp-for="Probability" class="form-control" type="number" min="0" max="100" />
                                    <span class="input-group-text bg-light">%</span>
                                </div>
                                <span asp-validation-for="Probability" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Row 3: Target Date & Status -->
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="ExpectedCloseDate" class="form-label fw-semibold text-secondary small">Expected Close Date <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-calendar-event"></i></span>
                                    <input asp-for="ExpectedCloseDate" class="form-control" type="date" value="@Model.ExpectedCloseDate.ToString("yyyy-MM-dd")" />
                                </div>
                                <span asp-validation-for="ExpectedCloseDate" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Status" class="form-label fw-semibold text-secondary small">Record Status <span class="text-danger">*</span></label>
                                <select asp-for="Status" class="form-select">
                                    <option value="Active" selected="@(Model.Status == AcxiomCRM.Models.OpportunityStatus.Active)">Active</option>
                                    <option value="Inactive" selected="@(Model.Status == AcxiomCRM.Models.OpportunityStatus.Inactive)">Inactive</option>
                                </select>
                                <span asp-validation-for="Status" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Row 4: Stage Change Note -->
                        <div class="mb-3">
                            <label asp-for="StageChangeNote" class="form-label fw-semibold text-secondary small">Stage Change Reason / Note</label>
                            <input asp-for="StageChangeNote" class="form-control" placeholder="Optional notes explaining stage progression, won terms, or loss reason" />
                            <span asp-validation-for="StageChangeNote" class="text-danger small"></span>
                        </div>

                        <!-- Row 5: Reassignment -->
                        @if (Model.CanReassign && Model.AvailableUsers.Any())
                        {
                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <label asp-for="AssignedToUserId" class="form-label fw-semibold text-secondary small">Assigned Account Executive</label>
                                    <select asp-for="AssignedToUserId" class="form-select">
                                        <option value="">-- Unassigned --</option>
                                        @foreach (var u in Model.AvailableUsers)
                                        {
                                            <option value="@u.Value" selected="@(Model.AssignedToUserId == u.Value)">@u.Text</option>
                                        }
                                    </select>
                                    <span asp-validation-for="AssignedToUserId" class="text-danger small"></span>
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="LeadId" class="form-label fw-semibold text-secondary small">Originating Lead (Optional)</label>
                                    <select asp-for="LeadId" class="form-select">
                                        <option value="">-- None / Direct --</option>
                                        @foreach (var l in Model.AvailableLeads)
                                        {
                                            <option value="@l.Value" selected="@(Model.LeadId.HasValue && Model.LeadId.Value.ToString() == l.Value)">@l.Text</option>
                                        }
                                    </select>
                                    <span asp-validation-for="LeadId" class="text-danger small"></span>
                                </div>
                            </div>
                        }
                        else
                        {
                            <input type="hidden" asp-for="AssignedToUserId" />
                            <input type="hidden" asp-for="LeadId" />
                        }

                        <!-- Row 6: Notes -->
                        <div class="mb-4">
                            <label asp-for="Notes" class="form-label fw-semibold text-secondary small">Deal Notes & Requirements</label>
                            <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Notes" class="text-danger small"></span>
                        </div>

                        <hr class="my-4" />

                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary px-4">Cancel</a>
                            <button type="submit" class="btn btn-primary px-4 shadow-sm">
                                <i class="bi bi-check2-circle me-1"></i> Update Opportunity
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
