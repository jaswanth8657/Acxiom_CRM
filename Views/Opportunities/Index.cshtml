@model AcxiomCRM.ViewModels.Opportunities.OpportunityListViewModel
@{
    ViewData["Title"] = "Sales Opportunities";
}

<div class="container-fluid py-3">
    <!-- Header -->
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center pb-3 mb-3 border-bottom">
        <div>
            <h1 class="h3 fw-bold text-dark mb-1">
                <i class="bi bi-currency-dollar text-primary me-2"></i>Sales Pipeline & Opportunities
            </h1>
            <p class="text-muted mb-0 small">
                Track enterprise deals, forecast weighted revenue, and drive pipeline velocity
            </p>
        </div>
        <div class="mt-3 mt-sm-0">
            <a asp-action="Create" class="btn btn-primary px-3 shadow-sm">
                <i class="bi bi-plus-circle me-1"></i> Add Opportunity
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Pipeline Summary KPI Cards -->
    <div class="row g-2 mb-4">
        <div class="col-6 col-md-4 col-xl-2">
            <div class="card border-0 shadow-sm bg-light text-center p-2 rounded-3 h-100">
                <div class="text-muted small fw-semibold">Total Deals</div>
                <div class="h4 fw-bold mb-0 text-dark">@Model.TotalOpportunities</div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-xl-2">
            <div class="card border-0 shadow-sm border-start border-primary border-3 text-center p-2 rounded-3 h-100">
                <div class="text-muted small fw-semibold">Open Deals</div>
                <div class="h4 fw-bold mb-0 text-primary">@Model.OpenOpportunities</div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-xl-2">
            <div class="card border-0 shadow-sm border-start border-success border-3 text-center p-2 rounded-3 h-100">
                <div class="text-muted small fw-semibold">Won Deals</div>
                <div class="h4 fw-bold mb-0 text-success">@Model.WonOpportunities</div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-xl-2">
            <div class="card border-0 shadow-sm border-start border-danger border-3 text-center p-2 rounded-3 h-100">
                <div class="text-muted small fw-semibold">Lost Deals</div>
                <div class="h4 fw-bold mb-0 text-danger">@Model.LostOpportunities</div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-xl-2">
            <div class="card border-0 shadow-sm border-start border-warning border-3 text-center p-2 rounded-3 h-100">
                <div class="text-muted small fw-semibold">Total Pipeline</div>
                <div class="h5 fw-bold mb-0 text-dark">@Model.TotalPipeline.ToString("C0")</div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-xl-2">
            <div class="card border-0 shadow-sm border-start border-info border-3 text-center p-2 rounded-3 h-100 bg-info bg-opacity-10">
                <div class="text-primary small fw-semibold">Weighted Pipeline</div>
                <div class="h5 fw-bold mb-0 text-primary">@Model.WeightedPipeline.ToString("C0")</div>
            </div>
        </div>
    </div>

    <!-- Search & Filter Card -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3 p-md-4">
            <form method="get" asp-action="Index" class="row g-2 align-items-end">
                <div class="col-12 col-md-4">
                    <label class="form-label small fw-semibold text-secondary">Search</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light text-muted"><i class="bi bi-search"></i></span>
                        <input type="text" name="SearchTerm" class="form-control" placeholder="Deal name, customer, lead..." value="@Model.Filter.SearchTerm" />
                    </div>
                </div>

                <div class="col-6 col-md-2">
                    <label class="form-label small fw-semibold text-secondary">Stage</label>
                    <select name="Stage" class="form-select">
                        <option value="">All Stages</option>
                        @foreach (var s in Model.AvailableStages)
                        {
                            <option value="@s.Value" selected="@(s.Selected)">@s.Text</option>
                        }
                    </select>
                </div>

                <div class="col-6 col-md-2">
                    <label class="form-label small fw-semibold text-secondary">Status</label>
                    <select name="Status" class="form-select">
                        <option value="">All Statuses</option>
                        @foreach (var st in Model.AvailableStatuses)
                        {
                            <option value="@st.Value" selected="@(st.Selected)">@st.Text</option>
                        }
                    </select>
                </div>

                @if (Model.CanManageAll && Model.AvailableUsers.Any())
                {
                    <div class="col-6 col-md-2">
                        <label class="form-label small fw-semibold text-secondary">Assigned Executive</label>
                        <select name="AssignedToUserId" class="form-select">
                            <option value="">All Executives</option>
                            @foreach (var user in Model.AvailableUsers)
                            {
                                <option value="@user.Value" selected="@(Model.Filter.AssignedToUserId == user.Value)">@user.Text</option>
                            }
                        </select>
                    </div>
                }

                <div class="col-12 @(Model.CanManageAll && Model.AvailableUsers.Any() ? "col-md-2" : "col-md-4") d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-funnel me-1"></i> Filter
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary" title="Clear Filters">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Opportunities Table Card -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <span class="fw-semibold text-dark">
                Total Deals: <strong>@Model.TotalItems</strong>
            </span>
            <span class="text-muted small">
                Page @Model.CurrentPage of @(Model.TotalPages == 0 ? 1 : Model.TotalPages)
            </span>
        </div>
        <div class="card-body p-0">
            @if (Model.Opportunities.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3 text-secondary small fw-semibold">Deal Name</th>
                                <th class="text-secondary small fw-semibold">Customer</th>
                                <th class="text-secondary small fw-semibold">Stage</th>
                                <th class="text-secondary small fw-semibold text-end">Amount</th>
                                <th class="text-secondary small fw-semibold text-center">Prob (%)</th>
                                <th class="text-secondary small fw-semibold text-end">Weighted Amount</th>
                                <th class="text-secondary small fw-semibold">Target Close</th>
                                <th class="text-secondary small fw-semibold">Assigned To</th>
                                <th class="text-secondary small fw-semibold">Status</th>
                                <th class="text-end pe-3 text-secondary small fw-semibold">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var opp in Model.Opportunities)
                            {
                                <tr>
                                    <td class="ps-3">
                                        <div class="fw-semibold text-dark">
                                            <a asp-action="Details" asp-route-id="@opp.Id" class="text-dark text-decoration-none">
                                                @opp.OpportunityName
                                            </a>
                                        </div>
                                        @if (!string.IsNullOrEmpty(opp.LeadName))
                                        {
                                            <div class="small text-muted">
                                                <i class="bi bi-funnel me-1"></i>From Lead: @opp.LeadName
                                            </div>
                                        }
                                    </td>
                                    <td>
                                        <a asp-controller="Customers" asp-action="Details" asp-route-id="@opp.CustomerId" class="text-primary text-decoration-none small fw-semibold">
                                            <i class="bi bi-building me-1"></i>@opp.CustomerName
                                        </a>
                                    </td>
                                    <td>
                                        @switch (opp.Stage)
                                        {
                                            case AcxiomCRM.Models.OpportunityStage.Prospecting:
                                                <span class="badge bg-secondary">Prospecting</span>
                                                break;
                                            case AcxiomCRM.Models.OpportunityStage.Qualification:
                                                <span class="badge bg-info text-dark">Qualification</span>
                                                break;
                                            case AcxiomCRM.Models.OpportunityStage.Proposal:
                                                <span class="badge bg-primary">Proposal</span>
                                                break;
                                            case AcxiomCRM.Models.OpportunityStage.Negotiation:
                                                <span class="badge bg-warning text-dark">Negotiation</span>
                                                break;
                                            case AcxiomCRM.Models.OpportunityStage.Won:
                                                <span class="badge bg-success"><i class="bi bi-check2-circle me-1"></i>Won</span>
                                                break;
                                            case AcxiomCRM.Models.OpportunityStage.Lost:
                                                <span class="badge bg-danger">Lost</span>
                                                break;
                                        }
                                    </td>
                                    <td class="text-end fw-bold text-dark">
                                        @opp.Amount.ToString("C")
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-light text-secondary border">@opp.Probability%</span>
                                    </td>
                                    <td class="text-end fw-semibold text-primary">
                                        @opp.WeightedAmount.ToString("C")
                                    </td>
                                    <td>
                                        <span class="small @(opp.ExpectedCloseDate < DateTime.Today && opp.Stage != AcxiomCRM.Models.OpportunityStage.Won && opp.Stage != AcxiomCRM.Models.OpportunityStage.Lost ? "text-danger fw-semibold" : "text-muted")">
                                            @opp.ExpectedCloseDate.ToString("MMM dd, yyyy")
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-secondary border">
                                            <i class="bi bi-person me-1"></i>@opp.AssignedToUserName
                                        </span>
                                    </td>
                                    <td>
                                        @if (opp.Status == AcxiomCRM.Models.OpportunityStatus.Active)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">Inactive</span>
                                        }
                                    </td>
                                    <td class="text-end pe-3">
                                        <div class="btn-group btn-group-sm">
                                            <a asp-action="Details" asp-route-id="@opp.Id" class="btn btn-outline-secondary" title="View Details">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            @if (opp.CanEdit)
                                            {
                                                <a asp-action="Edit" asp-route-id="@opp.Id" class="btn btn-outline-primary" title="Edit">
                                                    <i class="bi bi-pencil"></i>
                                                </a>
                                            }
                                            @if (opp.CanDelete)
                                            {
                                                <a asp-action="Delete" asp-route-id="@opp.Id" class="btn btn-outline-danger" title="Deactivate">
                                                    <i class="bi bi-trash"></i>
                                                </a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination Footer -->
                @if (Model.TotalPages > 1)
                {
                    <div class="card-footer bg-white py-3 border-top d-flex justify-content-between align-items-center">
                        <div class="text-muted small">
                            Showing @(((Model.CurrentPage - 1) * Model.PageSize) + 1) to @(Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalItems)) of @Model.TotalItems opportunities
                        </div>
                        <nav aria-label="Page navigation">
                            <ul class="pagination pagination-sm mb-0">
                                <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                                    <a class="page-link" asp-action="Index"
                                       asp-route-Page="@(Model.CurrentPage - 1)"
                                       asp-route-PageSize="@Model.Filter.PageSize"
                                       asp-route-SearchTerm="@Model.Filter.SearchTerm"
                                       asp-route-Stage="@Model.Filter.Stage"
                                       asp-route-Status="@Model.Filter.Status"
                                       asp-route-AssignedToUserId="@Model.Filter.AssignedToUserId">
                                        Previous
                                    </a>
                                </li>

                                @for (int i = 1; i <= Model.TotalPages; i++)
                                {
                                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                        <a class="page-link" asp-action="Index"
                                           asp-route-Page="@i"
                                           asp-route-PageSize="@Model.Filter.PageSize"
                                           asp-route-SearchTerm="@Model.Filter.SearchTerm"
                                           asp-route-Stage="@Model.Filter.Stage"
                                           asp-route-Status="@Model.Filter.Status"
                                           asp-route-AssignedToUserId="@Model.Filter.AssignedToUserId">
                                            @i
                                        </a>
                                    </li>
                                }

                                <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                                    <a class="page-link" asp-action="Index"
                                       asp-route-Page="@(Model.CurrentPage + 1)"
                                       asp-route-PageSize="@Model.Filter.PageSize"
                                       asp-route-SearchTerm="@Model.Filter.SearchTerm"
                                       asp-route-Stage="@Model.Filter.Stage"
                                       asp-route-Status="@Model.Filter.Status"
                                       asp-route-AssignedToUserId="@Model.Filter.AssignedToUserId">
                                        Next
                                    </a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                }
            }
            else
            {
                <div class="text-center py-5">
                    <div class="display-6 text-muted mb-3"><i class="bi bi-currency-dollar"></i></div>
                    <h5 class="fw-semibold text-secondary">No opportunities found</h5>
                    <p class="text-muted small mb-3">Create your first deal or adjust your search filter criteria.</p>
                    <a asp-action="Create" class="btn btn-primary btn-sm">
                        <i class="bi bi-plus-circle me-1"></i> Add Opportunity
                    </a>
                </div>
            }
        </div>
    </div>
</div>
