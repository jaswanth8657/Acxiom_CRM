@using AcxiomCRM.ViewModels.Reports
@using AcxiomCRM.Models
@model LeadReportViewModel

@{
    ViewData["Title"] = "Lead Report";
}

<div class="container-fluid py-3">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center pb-3 mb-4 border-bottom gap-2">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a asp-action="Index">Reports</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Lead Report</li>
                </ol>
            </nav>
            <h1 class="h3 fw-bold text-dark mb-0">
                <i class="bi bi-funnel text-info me-2"></i>Lead Report
            </h1>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="ExportLeads" 
               asp-route-searchTerm="@Model.SearchTerm" 
               asp-route-status="@Model.Status" 
               asp-route-source="@Model.Source" 
               asp-route-assignedToUserId="@Model.AssignedToUserId" 
               class="btn btn-outline-success">
                <i class="bi bi-file-earmark-spreadsheet me-1"></i> Export to CSV
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> All Reports
            </a>
        </div>
    </div>

    <!-- Filter Card -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3">
            <form method="get" asp-action="Leads" class="row g-2 align-items-center">
                <div class="col-12 col-md-3">
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                        <input type="text" name="SearchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Search leads..." />
                    </div>
                </div>

                <div class="col-6 col-md-2">
                    <select name="Status" class="form-select">
                        <option value="">All Statuses</option>
                        <option value="New" selected="@(Model.Status == LeadStatus.New)">New</option>
                        <option value="Contacted" selected="@(Model.Status == LeadStatus.Contacted)">Contacted</option>
                        <option value="Qualified" selected="@(Model.Status == LeadStatus.Qualified)">Qualified</option>
                        <option value="Lost" selected="@(Model.Status == LeadStatus.Lost)">Lost</option>
                        <option value="Converted" selected="@(Model.Status == LeadStatus.Converted)">Converted</option>
                    </select>
                </div>

                <div class="col-6 col-md-2">
                    <select name="Source" class="form-select">
                        <option value="">All Sources</option>
                        @foreach (var src in Model.AvailableSources)
                        {
                            <option value="@src.Value" selected="@(Model.Source == src.Value)">@src.Text</option>
                        }
                    </select>
                </div>

                @if (Model.CanFilterUsers)
                {
                    <div class="col-6 col-md-3">
                        <select name="AssignedToUserId" class="form-select">
                            <option value="">All Assigned Users</option>
                            @foreach (var user in Model.AvailableUsers)
                            {
                                <option value="@user.Value" selected="@(Model.AssignedToUserId == user.Value)">@user.Text</option>
                            }
                        </select>
                    </div>
                }

                <div class="col-12 col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary flex-grow-1">Filter</button>
                    <a asp-action="Leads" class="btn btn-outline-secondary">Reset</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Results Table -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <h6 class="fw-bold mb-0 text-dark">
                Results <span class="badge bg-secondary ms-1">@Model.TotalItems items</span>
            </h6>
            <div class="text-muted small">
                Page @Model.Page of @Math.Max(1, Model.TotalPages)
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light small">
                        <tr>
                            <th>Code</th>
                            <th>Lead Name</th>
                            <th>Company</th>
                            <th>Source</th>
                            <th>Status</th>
                            <th>Expected Value</th>
                            <th>Assigned To</th>
                            <th>Converted Status</th>
                            <th>Created Date</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Items != null && Model.Items.Any())
                        {
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td><span class="badge bg-light text-dark border">@item.LeadCode</span></td>
                                    <td class="fw-semibold">@item.LeadName</td>
                                    <td>@(item.CompanyName ?? "-")</td>
                                    <td><span class="badge bg-light text-dark border">@item.Source</span></td>
                                    <td>
                                        @if (item.Status == LeadStatus.New)
                                        {
                                            <span class="badge bg-primary">New</span>
                                        }
                                        else if (item.Status == LeadStatus.Contacted)
                                        {
                                            <span class="badge bg-info">Contacted</span>
                                        }
                                        else if (item.Status == LeadStatus.Qualified)
                                        {
                                            <span class="badge bg-warning text-dark">Qualified</span>
                                        }
                                        else if (item.Status == LeadStatus.Converted)
                                        {
                                            <span class="badge bg-success">Converted</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Lost</span>
                                        }
                                    </td>
                                    <td class="fw-bold text-dark">@item.ExpectedValue.ToString("C0")</td>
                                    <td>@item.AssignedToUserName</td>
                                    <td>
                                        @if (item.ConvertedCustomerId.HasValue)
                                        {
                                            <a asp-controller="Customers" asp-action="Details" asp-route-id="@item.ConvertedCustomerId.Value" class="badge bg-success-subtle text-success border border-success text-decoration-none">
                                                Customer: @item.ConvertedCustomerName
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">-</span>
                                        }
                                    </td>
                                    <td>@item.CreatedDate.ToString("yyyy-MM-dd")</td>
                                    <td>
                                        <a asp-controller="Leads" asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary py-0 px-2">
                                            View
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="10" class="text-center py-4 text-muted">
                                    <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                                    No lead records found matching the filter criteria.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        @if (Model.TotalPages > 1)
        {
            <div class="card-footer bg-white border-top d-flex justify-content-between align-items-center py-2">
                <div>
                    <span class="text-muted small">Showing @(Model.Items?.Count ?? 0) of @Model.TotalItems entries</span>
                </div>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                        <a class="page-link" asp-action="Leads" 
                           asp-route-page="@(Model.Page - 1)" 
                           asp-route-searchTerm="@Model.SearchTerm" 
                           asp-route-status="@Model.Status" 
                           asp-route-source="@Model.Source" 
                           asp-route-assignedToUserId="@Model.AssignedToUserId">Previous</a>
                    </li>
                    <li class="page-item active">
                        <span class="page-link">@Model.Page / @Model.TotalPages</span>
                    </li>
                    <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                        <a class="page-link" asp-action="Leads" 
                           asp-route-page="@(Model.Page + 1)" 
                           asp-route-searchTerm="@Model.SearchTerm" 
                           asp-route-status="@Model.Status" 
                           asp-route-source="@Model.Source" 
                           asp-route-assignedToUserId="@Model.AssignedToUserId">Next</a>
                    </li>
                </ul>
            </div>
        }
    </div>
</div>
