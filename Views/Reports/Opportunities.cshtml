@using AcxiomCRM.ViewModels.Reports
@using AcxiomCRM.Models
@model OpportunityReportViewModel

@{
    ViewData["Title"] = "Opportunity Report";
}

<div class="container-fluid py-3">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center pb-3 mb-4 border-bottom gap-2">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a asp-action="Index">Reports</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Opportunity Report</li>
                </ol>
            </nav>
            <h1 class="h3 fw-bold text-dark mb-0">
                <i class="bi bi-currency-dollar text-success me-2"></i>Opportunity Report
            </h1>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="ExportOpportunities" 
               asp-route-searchTerm="@Model.SearchTerm" 
               asp-route-stage="@Model.Stage" 
               asp-route-status="@Model.Status" 
               asp-route-assignedToUserId="@Model.AssignedToUserId" 
               class="btn btn-outline-success">
                <i class="bi bi-file-earmark-spreadsheet me-1"></i> Export to CSV
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> All Reports
            </a>
        </div>
    </div>

    <!-- Filter Card -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3">
            <form method="get" asp-action="Opportunities" class="row g-2 align-items-center">
                <div class="col-12 col-md-3">
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                        <input type="text" name="SearchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Search opportunities..." />
                    </div>
                </div>

                <div class="col-6 col-md-2">
                    <select name="Stage" class="form-select">
                        <option value="">All Stages</option>
                        <option value="Qualification" selected="@(Model.Stage == OpportunityStage.Qualification)">Qualification</option>
                        <option value="Proposal" selected="@(Model.Stage == OpportunityStage.Proposal)">Proposal</option>
                        <option value="Negotiation" selected="@(Model.Stage == OpportunityStage.Negotiation)">Negotiation</option>
                        <option value="Won" selected="@(Model.Stage == OpportunityStage.Won)">Won</option>
                        <option value="Lost" selected="@(Model.Stage == OpportunityStage.Lost)">Lost</option>
                    </select>
                </div>

                <div class="col-6 col-md-2">
                    <select name="Status" class="form-select">
                        <option value="">All Statuses</option>
                        <option value="Active" selected="@(Model.Status == OpportunityStatus.Active)">Active</option>
                        <option value="Inactive" selected="@(Model.Status == OpportunityStatus.Inactive)">Inactive</option>
                    </select>
                </div>

                @if (Model.CanFilterUsers)
                {
                    <div class="col-6 col-md-3">
                        <select name="AssignedToUserId" class="form-select">
                            <option value="">All Assigned Users</option>
                            @foreach (var user in Model.AvailableUsers)
                            {
                                <option value="@user.Value" selected="@(Model.AssignedToUserId == user.Value)">@user.Text</option>
                            }
                        </select>
                    </div>
                }

                <div class="col-12 col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary flex-grow-1">Filter</button>
                    <a asp-action="Opportunities" class="btn btn-outline-secondary">Reset</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Results Table -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <h6 class="fw-bold mb-0 text-dark">
                Results <span class="badge bg-secondary ms-1">@Model.TotalItems items</span>
            </h6>
            <div class="text-muted small">
                Page @Model.Page of @Math.Max(1, Model.TotalPages)
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light small">
                        <tr>
                            <th>Deal Name</th>
                            <th>Customer</th>
                            <th>Stage</th>
                            <th>Amount</th>
                            <th>Prob (%)</th>
                            <th>Weighted Value</th>
                            <th>Expected Close</th>
                            <th>Status</th>
                            <th>Assigned To</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Items != null && Model.Items.Any())
                        {
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td class="fw-semibold">@item.OpportunityName</td>
                                    <td>@item.CustomerName</td>
                                    <td>
                                        @if (item.Stage == OpportunityStage.Won)
                                        {
                                            <span class="badge bg-success">Won</span>
                                        }
                                        else if (item.Stage == OpportunityStage.Lost)
                                        {
                                            <span class="badge bg-danger">Lost</span>
                                        }
                                        else if (item.Stage == OpportunityStage.Negotiation)
                                        {
                                            <span class="badge bg-warning text-dark">Negotiation</span>
                                        }
                                        else if (item.Stage == OpportunityStage.Proposal)
                                        {
                                            <span class="badge bg-info text-dark">Proposal</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Qualification</span>
                                        }
                                    </td>
                                    <td class="fw-bold text-dark">@item.Amount.ToString("C0")</td>
                                    <td>@item.Probability%</td>
                                    <td class="text-success fw-bold">@item.WeightedAmount.ToString("C0")</td>
                                    <td>@item.ExpectedCloseDate.ToString("yyyy-MM-dd")</td>
                                    <td>
                                        @if (item.Status == OpportunityStatus.Active)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger">Inactive</span>
                                        }
                                    </td>
                                    <td>@item.AssignedToUserName</td>
                                    <td>
                                        <a asp-controller="Opportunities" asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary py-0 px-2">
                                            View
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="10" class="text-center py-4 text-muted">
                                    <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                                    No opportunity records found matching the filter criteria.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        @if (Model.TotalPages > 1)
        {
            <div class="card-footer bg-white border-top d-flex justify-content-between align-items-center py-2">
                <div>
                    <span class="text-muted small">Showing @(Model.Items?.Count ?? 0) of @Model.TotalItems entries</span>
                </div>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                        <a class="page-link" asp-action="Opportunities" 
                           asp-route-page="@(Model.Page - 1)" 
                           asp-route-searchTerm="@Model.SearchTerm" 
                           asp-route-stage="@Model.Stage" 
                           asp-route-status="@Model.Status" 
                           asp-route-assignedToUserId="@Model.AssignedToUserId">Previous</a>
                    </li>
                    <li class="page-item active">
                        <span class="page-link">@Model.Page / @Model.TotalPages</span>
                    </li>
                    <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                        <a class="page-link" asp-action="Opportunities" 
                           asp-route-page="@(Model.Page + 1)" 
                           asp-route-searchTerm="@Model.SearchTerm" 
                           asp-route-stage="@Model.Stage" 
                           asp-route-status="@Model.Status" 
                           asp-route-assignedToUserId="@Model.AssignedToUserId">Next</a>
                    </li>
                </ul>
            </div>
        }
    </div>
</div>
