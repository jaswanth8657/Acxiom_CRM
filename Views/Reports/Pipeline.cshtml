@using AcxiomCRM.ViewModels.Reports
@using AcxiomCRM.Models
@model PipelineReportViewModel

@{
    ViewData["Title"] = "Pipeline Report";
}

<div class="container-fluid py-3">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center pb-3 mb-4 border-bottom gap-2">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a asp-action="Index">Reports</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Pipeline Report</li>
                </ol>
            </nav>
            <h1 class="h3 fw-bold text-dark mb-0">
                <i class="bi bi-bar-chart-steps text-primary me-2"></i>Sales Pipeline Report
            </h1>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="ExportPipeline" class="btn btn-outline-success">
                <i class="bi bi-file-earmark-spreadsheet me-1"></i> Export to CSV
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> All Reports
            </a>
        </div>
    </div>

    <!-- Summary KPI Cards -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm rounded-3 h-100 border-start border-primary border-4">
                <div class="card-body p-3">
                    <div class="text-muted small fw-semibold text-uppercase">Active Open Deals</div>
                    <div class="fs-4 fw-bold text-dark my-1">@Model.TotalOpenDeals</div>
                    <div class="small text-muted">Excludes Won & Lost</div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm rounded-3 h-100 border-start border-info border-4">
                <div class="card-body p-3">
                    <div class="text-muted small fw-semibold text-uppercase">Total Pipeline Value</div>
                    <div class="fs-4 fw-bold text-info my-1">@Model.TotalPipeline.ToString("C0")</div>
                    <div class="small text-muted">Gross unweighted value</div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm rounded-3 h-100 border-start border-success border-4">
                <div class="card-body p-3">
                    <div class="text-muted small fw-semibold text-uppercase">Weighted Pipeline Value</div>
                    <div class="fs-4 fw-bold text-success my-1">@Model.TotalWeightedPipeline.ToString("C0")</div>
                    <div class="small text-muted">Probability-weighted forecast</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Stage Breakdown Table -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-header bg-white py-3 border-bottom">
            <h5 class="fw-bold mb-0 text-dark">
                <i class="bi bi-funnel text-primary me-2"></i>Stage-Wise Pipeline Breakdown
            </h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light small">
                        <tr>
                            <th>Pipeline Stage</th>
                            <th class="text-center">Deals Count</th>
                            <th class="text-end">Total Amount</th>
                            <th class="text-end">Weighted Amount</th>
                            <th class="text-end">Pipeline Share</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.StageBreakdowns != null && Model.StageBreakdowns.Any())
                        {
                            @foreach (var stage in Model.StageBreakdowns)
                            {
                                <tr>
                                    <td>
                                        <span class="fw-semibold">@stage.Stage</span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-light text-dark border">@stage.DealCount deals</span>
                                    </td>
                                    <td class="text-end fw-bold text-dark">
                                        @stage.TotalAmount.ToString("C0")
                                    </td>
                                    <td class="text-end fw-bold text-success">
                                        @stage.WeightedAmount.ToString("C0")
                                    </td>
                                    <td class="text-end">
                                        <div class="d-flex align-items-center justify-content-end gap-2">
                                            <span>@stage.SharePercentage%</span>
                                            <div class="progress" style="width: 80px; height: 8px;">
                                                <div class="progress-bar bg-primary" role="progressbar" style="width: @stage.SharePercentage%" aria-valuenow="@stage.SharePercentage" aria-valuemin="0" aria-valuemax="100"></div>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted">
                                    No active pipeline data available.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Owner Breakdown Table (if multiple owners) -->
    @if (Model.OwnerBreakdowns != null && Model.OwnerBreakdowns.Any())
    {
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-white py-3 border-bottom">
                <h5 class="fw-bold mb-0 text-dark">
                    <i class="bi bi-people text-info me-2"></i>Sales Representative Pipeline Breakdown
                </h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light small">
                            <tr>
                                <th>Sales Representative</th>
                                <th class="text-center">Deals Count</th>
                                <th class="text-end">Total Amount</th>
                                <th class="text-end">Weighted Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var owner in Model.OwnerBreakdowns)
                            {
                                <tr>
                                    <td class="fw-semibold">@owner.UserName</td>
                                    <td class="text-center"><span class="badge bg-light text-dark border">@owner.DealCount</span></td>
                                    <td class="text-end fw-bold text-dark">@owner.TotalAmount.ToString("C0")</td>
                                    <td class="text-end fw-bold text-success">@owner.WeightedAmount.ToString("C0")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>
