@using AcxiomCRM.ViewModels.Reports
@model UserActivityReportViewModel

@{
    ViewData["Title"] = "User Activity Report";
}

<div class="container-fluid py-3">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center pb-3 mb-4 border-bottom gap-2">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a asp-action="Index">Reports</a></li>
                    <li class="breadcrumb-item active" aria-current="page">User Activity Report</li>
                </ol>
            </nav>
            <h1 class="h3 fw-bold text-dark mb-0">
                <i class="bi bi-people text-info me-2"></i>User Activity & Productivity Report
            </h1>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="ExportUserActivity" 
               asp-route-startDate="@(Model.StartDate?.ToString("yyyy-MM-dd"))" 
               asp-route-endDate="@(Model.EndDate?.ToString("yyyy-MM-dd"))" 
               class="btn btn-outline-success">
                <i class="bi bi-file-earmark-spreadsheet me-1"></i> Export to CSV
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> All Reports
            </a>
        </div>
    </div>

    <!-- Date Range Filter -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3">
            <form method="get" asp-action="UserActivity" class="row g-2 align-items-center">
                <div class="col-12 col-md-4">
                    <label class="form-label small text-muted mb-0">From Date</label>
                    <input type="date" name="startDate" value="@(Model.StartDate?.ToString("yyyy-MM-dd"))" class="form-control" />
                </div>
                <div class="col-12 col-md-4">
                    <label class="form-label small text-muted mb-0">To Date</label>
                    <input type="date" name="endDate" value="@(Model.EndDate?.ToString("yyyy-MM-dd"))" class="form-control" />
                </div>
                <div class="col-12 col-md-4 d-flex align-items-end gap-2 pt-3 pt-md-0">
                    <button type="submit" class="btn btn-primary flex-grow-1">Filter Activity</button>
                    <a asp-action="UserActivity" class="btn btn-outline-secondary">Reset</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Productivity Table -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-header bg-white py-3 border-bottom">
            <h5 class="fw-bold mb-0 text-dark">
                <i class="bi bi-clipboard2-data text-primary me-2"></i>Sales Team Activity Breakdown
            </h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light small">
                        <tr>
                            <th>User Name</th>
                            <th>Role</th>
                            <th class="text-center">Total Activities</th>
                            <th class="text-center">Calls</th>
                            <th class="text-center">Meetings</th>
                            <th class="text-center">Emails</th>
                            <th class="text-center">Tasks</th>
                            <th class="text-center">Done Follow-Ups</th>
                            <th class="text-center">Deals Won</th>
                            <th class="text-end">Won Value</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Summaries != null && Model.Summaries.Any())
                        {
                            @foreach (var user in Model.Summaries)
                            {
                                <tr>
                                    <td class="fw-semibold">@user.UserName</td>
                                    <td>
                                        @if (user.Role == "Admin")
                                        {
                                            <span class="badge bg-danger">Admin</span>
                                        }
                                        else if (user.Role == "Manager")
                                        {
                                            <span class="badge bg-primary">Manager</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-info text-dark">SalesExecutive</span>
                                        }
                                    </td>
                                    <td class="text-center fw-bold">@user.TotalActivities</td>
                                    <td class="text-center"><span class="badge bg-light text-dark border">@user.CallsCount</span></td>
                                    <td class="text-center"><span class="badge bg-light text-dark border">@user.MeetingsCount</span></td>
                                    <td class="text-center"><span class="badge bg-light text-dark border">@user.EmailsCount</span></td>
                                    <td class="text-center"><span class="badge bg-light text-dark border">@user.TasksCount</span></td>
                                    <td class="text-center"><span class="badge bg-success-subtle text-success border border-success">@user.CompletedFollowUps</span></td>
                                    <td class="text-center fw-bold text-success">@user.WonDealsCount</td>
                                    <td class="text-end fw-bold text-success">@user.WonDealsValue.ToString("C0")</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="10" class="text-center py-4 text-muted">
                                    No activity logs found for the selected criteria.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
