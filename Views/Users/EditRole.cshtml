@model AcxiomCRM.ViewModels.Users.UserEditRoleViewModel
@{
    ViewData["Title"] = "Change User Role";
}

<div class="container py-4" style="max-width: 550px;">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3">
            <h4 class="mb-0 fw-bold">
                <i class="bi bi-shield-lock text-primary me-2"></i> Change User Role
            </h4>
        </div>
        <div class="card-body p-4">
            <div class="mb-3">
                <label class="form-label text-muted small">Target User</label>
                <div class="fw-bold fs-5">@Model.FullName</div>
                <div class="text-secondary small">@Model.Email</div>
            </div>

            <div class="mb-3">
                <label class="form-label text-muted small">Current Primary Role</label>
                <div>
                    <span class="badge bg-secondary fs-6">@Model.CurrentRole</span>
                </div>
            </div>

            <hr />

            <form asp-action="EditRole" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="UserId" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="mb-4">
                    <label asp-for="SelectedRole" class="form-label fw-semibold"></label>
                    <select asp-for="SelectedRole" asp-items="Model.AvailableRoles" class="form-select"></select>
                    <span asp-validation-for="SelectedRole" class="text-danger small"></span>
                    <div class="form-text">
                        Assigning a new role enforces single primary role architecture (previous roles will be replaced).
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i> Cancel
                    </a>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check2-circle me-1"></i> Save Role
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
