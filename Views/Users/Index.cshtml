@model List<AcxiomCRM.ViewModels.Users.UserListItemViewModel>
@{
    ViewData["Title"] = "User & Role Management";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="h3 fw-bold mb-1">
                <i class="bi bi-people-fill text-primary me-2"></i> User & Role Management
            </h2>
            <p class="text-muted mb-0">Manage system users, assign roles, and toggle access states.</p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-person-plus me-1"></i> Add New User
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-1"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-1"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3">
            <div class="fw-semibold text-secondary">
                <i class="bi bi-table me-1"></i> Registered System Users (@Model.Count)
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>User</th>
                            <th>Email</th>
                            <th>Assigned Role</th>
                            <th>Status</th>
                            <th>Created Date</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            <tr>
                                <td>
                                    <div class="fw-bold">@user.FullName</div>
                                    @if (user.IsCurrentUser)
                                    {
                                        <span class="badge bg-secondary small">You</span>
                                    }
                                </td>
                                <td>@user.Email</td>
                                <td>
                                    @if (user.Role == "Admin")
                                    {
                                        <span class="badge bg-danger text-uppercase px-2 py-1">Admin</span>
                                    }
                                    else if (user.Role == "Manager")
                                    {
                                        <span class="badge bg-primary text-uppercase px-2 py-1">Manager</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-info text-dark text-uppercase px-2 py-1">SalesExecutive</span>
                                    }
                                </td>
                                <td>
                                    @if (user.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Deactivated</span>
                                    }
                                </td>
                                <td>@user.CreatedDate.ToString("yyyy-MM-dd HH:mm")</td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="EditRole" asp-route-id="@user.Id" class="btn btn-outline-primary" title="Change Role">
                                            <i class="bi bi-shield me-1"></i> Role
                                        </a>
                                        @if (!user.IsCurrentUser)
                                        {
                                            <form asp-action="ToggleActive" asp-route-id="@user.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to @(user.IsActive ? "deactivate" : "activate") this user?');">
                                                @Html.AntiForgeryToken()
                                                @if (user.IsActive)
                                                {
                                                    <button type="submit" class="btn btn-outline-danger" title="Deactivate User">
                                                        <i class="bi bi-person-x"></i> Deactivate
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button type="submit" class="btn btn-outline-success" title="Activate User">
                                                        <i class="bi bi-person-check"></i> Activate
                                                    </button>
                                                }
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
